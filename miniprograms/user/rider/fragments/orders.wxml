<import src="./common.wxml"/>
<view class="row page-heading">
  <view class="h2">每一单，安心送达</view>
  <template is="chip" data="{{label: active.length + ' 笔配送中'}}"/>
</view>
<view class="segmented">
  <button class="filter {{ordersSubTab !== 'history' ? 'active' : ''}}" data-subtab="active" bindtap="switchOrdersSubTab"><text class="control-label">配送中 {{active.length}}</text></button>
  <button class="filter {{ordersSubTab === 'history' ? 'active' : ''}}" data-subtab="history" bindtap="switchOrdersSubTab"><text class="control-label">历史记录</text></button>
</view>
<block wx:if="{{ordersSubTab === 'history'}}">
  <view class="top-space">
    <template is="filters" data="{{filters: historyFilters, filter: historyFilter}}"/>
  </view>
  <template wx:for="{{historyVisibleItems}}" wx:key="id" is="orderCard" data="{{order: item}}"/>
  <template wx:if="{{!historyVisibleItems.length}}" is="empty"
    data="{{title: '暂无这类历史记录', description: '完成配送或已关闭订单会显示在这里。'}}"/>
  <button wx:if="{{historyHasMore}}" class="btn outline full" bindtap="moreHistory" loading="{{busy}}" disabled="{{busy}}">查看更多</button>
</block>
<block wx:else>
  <template is="note" data="{{label: location.message, icon: 'pin'}}"/>
  <template wx:for="{{active}}" wx:key="id" is="orderCard" data="{{order: item, actions: true}}"/>
  <template wx:if="{{!active.length}}" is="empty"
    data="{{title: '当前没有配送任务', description: '前往暂存点，扫描餐品小票逐单领取。'}}"/>
  <template is="action" data="{{busy, page: 'scan', icon: 'scan', label: active.length ? '继续扫码领取' : '去扫码领取'}}"/>
</block>
