<wxs module="states" src="../utils/states.wxs"/>
<import src="./common.wxml"/>
<view class="details-title">
  <view class="successcircle {{withdrawal.status === 'PAYOUT_FAILED' || withdrawal.status === 'REVIEW_REJECTED' ? 'result-error' : ''}}">
    <template is="icon" data="{{name: withdrawal.status === 'PAID' ? 'check' : (withdrawal.status === 'PAYOUT_FAILED' || withdrawal.status === 'REVIEW_REJECTED') ? 'info' : 'clock',
      tone: (withdrawal.status === 'PAYOUT_FAILED' || withdrawal.status === 'REVIEW_REJECTED') ? 'amber' : 'green',
      size: 'icon-large'}}"/>
  </view>
  <view class="h2">{{states.label(withdrawal.status)}}</view>
  <view class="big-money withdraw-amount"><text class="small">¥</text>{{withdrawal.amount}}</view>
  <text class="small muted">{{withdrawal.status === 'PENDING_REVIEW' ? '已提交申请，等待管理员审核' : '可在下方查看处理进度'}}</text>
</view>
<template wx:if="{{withdrawal.notice}}" is="note" data="{{label: withdrawal.notice, tone: 'warn'}}"/>
<view class="card">
  <template is="pairs" data="{{rows: [{label:'申请单号',value:withdrawal.id},{label:'收款账户',value:'当前微信账户'},
    {label:'申请时间',value:withdrawal.time},{label:'金额状态',value:withdrawal.status === 'PAID' ? '已支出' :
      (withdrawal.status === 'REVIEW_REJECTED' || withdrawal.status === 'PAYOUT_FAILED') ? '已解除冻结' : '申请金额已冻结'}]}}"/>
  <view class="divider"/>
  <view class="timeline">
    <view class="timeline-item"><text class="strong">已提交申请</text><text class="span">{{withdrawal.time}}</text></view>
    <view class="timeline-item {{index === withdrawal.timeline.length - 1 ? 'current' : ''}}"
      wx:for="{{withdrawal.timeline}}" wx:key="index">
      <text class="strong">{{states.label(item.status)}}</text><text class="span">{{item.time}}</text>
    </view>
  </view>
</view>
<view class="withdrawal-actions">
  <template is="action" data="{{page: 'withdrawals', label: '返回提现记录', style: 'receipt-back'}}"/>
  <button wx:if="{{withdrawal.confirmation}}" class="btn primary receipt-confirm"
    bindtap="confirmReceipt" hover-class="pressed">微信确认收款</button>
</view>
