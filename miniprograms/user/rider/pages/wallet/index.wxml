<wxs module="states" src="../../utils/states.wxs"/>
<import src="../../fragments/common.wxml"/>
<view class="page root-page">
  <view class="root-content">
    <view wx:if="{{error}}" class="card error-card">
      <template is="note" data="{{label: error, tone: 'error'}}"/>
      <button class="btn outline full" bindtap="refresh" hover-class="pressed">重新加载</button>
      <button wx:if="{{activeTab === 'mine'}}" class="btn outline full top-space" bindtap="openRolePicker" hover-class="pressed">切换角色</button>
    </view>
    <view wx:elif="{{loading && !loaded}}" class="empty small muted">正在加载…</view>
    <template wx:elif="{{gate && activeTab !== 'mine' && activeTab !== 'home'}}" is="empty"
      data="{{title: profile.auditStatus === 'PENDING_REVIEW' ? '学生身份审核中' : '先完成入驻，再开始配送',
        description: '通过学生身份审核后，才可在暂存点扫码领取餐品。', page: 'audit', label: '查看入驻状态'}}"/>
    <block wx:else>
      <view hidden="{{activeTab !== 'home'}}"><include src="../../fragments/home.wxml"/></view>
      <view hidden="{{activeTab !== 'orders'}}"><include src="../../fragments/orders.wxml"/></view>
      <view hidden="{{activeTab !== 'wallet'}}"><include src="../../fragments/wallet.wxml"/></view>
      <view hidden="{{activeTab !== 'mine'}}"><include src="../../fragments/mine.wxml"/></view>
    </block>
  </view>
  <view class="root-footer"><rider-tab-bar inline in-place selected="{{activeTab}}" bind:switch="switchRiderTab"/></view>
</view>
<template wx:if="{{modal}}" is="modal" data="{{modal, busy}}"/>
