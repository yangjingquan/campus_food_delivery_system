.tab-shell {
  position: fixed;
  z-index: 20;
  right: 15px;
  bottom: max(15px, env(safe-area-inset-bottom));
  left: 15px;
  max-width: 530px;
  margin: auto;
}

.tabbar {
  display: flex;
  height: 64px;
  border-radius: 32px;
  background: #fff;
  box-shadow: 0 7px 0 #eceee7;
}

.tabbar .tab, .tab-shell .cart-fab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  max-width: none;
  margin: 0;
  padding: 0;
  border: 0;
}

.tabbar .tab {
  flex: 1 1 0;
  flex-direction: column;
  gap: 3px;
  border-radius: 32px;
  background: transparent;
  color: #7b807a;
  font-size: 10px;
  line-height: 1.35;
}
.tabbar .tab::after, .tab-shell .cart-fab::after { border: 0; }
.tabbar .tab.on { color: #ee692f; font-weight: 700; }
.tab-icon { display: block; width: 22px; height: 22px; }
.cart-float {
  position: absolute;
  right: 7px;
  bottom: 83px;
  overflow: visible;
}
.tab-shell .cart-fab {
  width: 44px;
  height: 44px;
  border-radius: 17px;
  background: rgba(238, 105, 47, .76);
  box-shadow: 2px 3px 0 rgba(41, 44, 41, .08);
}
.cart-fab-icon { display: block; width: 20px; height: 20px; }
.badge {
  position: absolute;
  top: -5px;
  right: -3px;
  box-sizing: border-box;
  min-width: 20px;
  height: 20px;
  padding: 0 4px;
  border-radius: 10px;
  background: #292c29;
  color: #fff;
  text-align: center;
  font-size: 10px;
  font-weight: 700;
  line-height: 20px;
  white-space: nowrap;
  pointer-events: none;
}
