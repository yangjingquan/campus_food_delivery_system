.tabbar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(66px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  border-top: 1px solid #e9e7df;
  background: #fff;
}

.tabbar .tab {
  position: relative;
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  width: 25%;
  min-width: 0;
  max-width: none;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #686b61;
  font-size: 11px;
  line-height: 1.35;
}
.tabbar .tab::after { border: 0; }
.tabbar .tab.on { color: #b74416; font-weight: 700; }
.tab-icon { display: block; width: 21px; height: 21px; }
.badge { position: absolute; top: 5px; left: calc(50% + 8px); padding: 1px 4px; border-radius: 12px; color: #fff; background: #c54a1a; font-size: 10px; }
