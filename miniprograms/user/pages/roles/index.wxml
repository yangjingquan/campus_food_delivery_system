<view class="picker-page">
  <view class="picker-list">
    <button wx:for="{{options}}" wx:key="id" class="role-option"
      data-role="{{item.id}}" bindtap="select" hover-class="role-pressed"
      disabled="{{!!pending}}" aria-current="{{current === item.id ? 'true' : 'false'}}">
      <view class="role-icon"><image src="{{item.icon}}" mode="aspectFit" aria-hidden="true"/></view>
      <view class="role-copy"><text class="role-name">{{item.name}}</text><text class="role-description">{{item.description}}</text></view>
      <text wx:if="{{pending === item.id}}" class="role-status">正在进入…</text>
      <text wx:elif="{{current === item.id}}" class="role-status">当前</text>
      <view wx:else class="role-arrow" aria-hidden="true"/>
    </button>
  </view>
  <view wx:if="{{error}}" class="role-error" aria-live="polite">{{error}}</view>
</view>
