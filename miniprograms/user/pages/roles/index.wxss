@import "../../styles/base.wxss";

.picker-page {
  max-width: 560px;
  margin: 0 auto;
  padding: 18px 16px calc(20px + env(safe-area-inset-bottom));
}
.picker-intro {
  margin-bottom: 14px;
  color: var(--muted);
  font-size: 13px;
}
.picker-list {
  display: grid;
  gap: 10px;
}
.picker-list .role-option {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 76px;
  margin: 0;
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--surface);
  color: var(--ink);
  text-align: left;
  line-height: 1.4;
  white-space: normal;
}
.picker-list .role-option.is-current {
  border-color: var(--accent);
  background: #fffaf6;
}
.role-option::after { border: 0; }
.picker-list .role-pressed { background: #f4f6f0; }
.picker-list .role-option[disabled] { opacity: .75; }
.role-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42px;
  height: 42px;
  border-radius: 13px;
  background: #edf3eb;
}
.role-icon-user { background: #fff0e7; }
.role-icon-merchant { background: #e6f3ea; }
.role-icon-rider { background: #eaf2ee; }
.role-icon image { width: 22px; height: 22px; }
.role-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3px; }
.role-name { font-size: 16px; font-weight: 700; }
.role-description { color: var(--muted); font-size: 12px; }
.role-status { flex: none; color: #24674d; font-size: 12px; font-weight: 600; }
.role-status.is-badge { padding: 4px 10px; border-radius: 999px; background: #fff0e7; color: #a84b21; }
.role-arrow { flex: 0 0 6px; height: 6px; border: solid #626961; border-width: 1.5px 1.5px 0 0; transform: rotate(45deg); }
.role-error { margin: 12px 2px 0; color: #a23a1b; font-size: 13px; }
