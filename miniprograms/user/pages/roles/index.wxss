@import "../../styles/base.wxss";

.picker-page {
  max-width: 560px;
  margin: 0 auto;
  padding: 18px 16px calc(20px + env(safe-area-inset-bottom));
}

.picker-list {
  overflow: hidden;
  border-radius: 16px;
  background: var(--surface);
}

.picker-list .role-option {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 70px;
  margin: 0;
  padding: 12px 16px;
  border-radius: 0;
  background: var(--surface);
  color: var(--ink);
  text-align: left;
  line-height: 1.4;
  white-space: normal;
}

.role-option + .role-option { border-top: 1px solid var(--line); }
.role-option::after { border: 0; }
.picker-list .role-pressed { background: #f4f6f0; }
.picker-list .role-option[disabled] { opacity: .75; }
.role-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 38px;
  height: 38px;
  border-radius: 12px;
  background: #edf3eb;
}
.role-icon image { width: 22px; height: 22px; }
.role-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3px; }
.role-name { font-size: 15px; font-weight: 700; }
.role-description { color: var(--muted); font-size: 13px; }
.role-status { flex: none; color: #24674d; font-size: 12px; }
.role-arrow { flex: 0 0 6px; height: 6px; border: solid #626961; border-width: 1px 1px 0 0; transform: rotate(45deg); }
.role-error { margin: 10px 2px 0; color: #a23a1b; font-size: 13px; }
