<view class="page tab-page mine-page">
  <view class="profile">
    <button wx:if="{{user}}" class="profile-avatar" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"
      disabled="{{working}}" aria-label="更换头像">
      <image wx:if="{{avatarPath}}" class="avatar" src="{{avatarPath}}" mode="aspectFill" aria-hidden="true" />
      <view wx:else class="avatar" aria-hidden="true">{{user.initial}}</view>
    </button>
    <view wx:else class="avatar" aria-hidden="true">食</view>
    <view class="profile-copy">
      <input wx:if="{{editingNickname}}" class="nickname-input" type="nickname"
        value="{{draftName}}" focus="{{editingNickname}}" placeholder="请输入昵称"
        bindchange="saveNickname" bindblur="saveNickname" disabled="{{working}}" aria-label="昵称" />
      <button wx:elif="{{user}}" class="profile-name" bindtap="editNickname" disabled="{{working}}"
        aria-label="修改昵称 {{user.displayName}}">
        <text class="h2">{{user.displayName}}</text><text class="muted" aria-hidden="true">›</text>
      </button>
      <view wx:else class="h2">欢迎来到寝食记</view>
      <view wx:if="{{!editingNickname}}" class="small">{{user ? '已登录 · 校园用户' : '登录后可下单及查看本人订单'}}</view>
    </view>
  </view>
  <button wx:if="{{!user}}" class="btn wide" bindtap="login" loading="{{working}}" disabled="{{working}}">微信登录</button>
  <view wx:if="{{message}}" class="hint orange profile-message">{{message}}</view>
  <view class="card menu-card">
    <button class="menurow" data-action="orders" bindtap="open"><text>我的订单</text><text class="muted">›</text></button>
    <button class="menurow" data-action="addresses" bindtap="open"><text>收餐地址</text><text class="muted">›</text></button>
    <button class="menurow" data-action="rules" bindtap="open"><text>配送规则与费用</text><text class="muted">›</text></button>
    <button class="menurow" open-type="contact"><text>联系平台客服</text><text class="muted">›</text></button>
    <button class="menurow" data-action="privacy" bindtap="open"><text>隐私与服务说明</text><text class="muted">›</text></button>
    <button class="menurow" data-action="about" bindtap="open"><text>关于寝食记</text><text class="muted">›</text></button>
  </view>
  <button wx:if="{{user}}" class="btn secondary wide" bindtap="logout" loading="{{working}}" disabled="{{working}}">退出登录</button>
</view>
