.mine-page { padding-top: 14px; }
.profile-panel {
  position: relative;
  overflow: hidden;
  min-height: 150px;
  padding: 12px 14px 14px;
  border: 1px solid #ecdccb;
  border-radius: 24px;
  background: linear-gradient(135deg, #fff9f2, #f4dfc8);
}
.profile-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.profile-label, .profile { position: relative; }
.profile-label { margin-left: 1px; color: #8d694c; font-size: 10px; font-weight: 700; }
.mine-page .profile { align-items: flex-start; gap: 14px; padding: 13px 0 0; }
.profile-copy { flex: 1; min-width: 0; padding-top: 2px; }
.mine-page button.profile-avatar { flex: 0 0 68px; text-align: center; }
.avatar-frame { position: relative; flex: 0 0 68px; width: 68px; height: 68px; padding: 3px; border-radius: 23px; background: white; }
.mine-page .avatar { display: flex; width: 62px; height: 62px; color: #aa5626; font-size: 24px; background: linear-gradient(135deg, #f9e4c9, #edc69e); }
.camera { position: absolute; right: -1px; bottom: -4px; display: grid; place-items: center; width: 21px; height: 21px; border: 1px solid #ead8c6; border-radius: 8px; background: white; }
.camera image, .nickname-link image { width: 14px; height: 14px; }
.avatar-caption { display: block; margin-top: 6px; color: #765d47; font-size: 10px; }
.mine-page button.profile-name, .guest-title { display: block; max-width: 100%; text-align: left; font-size: 23px; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }
.guest-title { font-size: 20px; }
.profile-status { margin-top: 7px; color: #756458; font-size: 11px; }
.mine-page button.nickname-link { display: flex; align-items: center; gap: 6px; min-height: 34px; color: #855631; font-size: 11px; }
.nickname-input { height: 36px; padding: 0 10px; border: 1px solid #dec6af; border-radius: 10px; background: white; }
.mine-page button.profile-login { min-width: 132px; margin-top: 8px; }
.profile-message { margin-top: 12px; }
.profile-shortcuts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; margin-top: 14px; }
.mine-page button.shortcut, .mine-page button.rules-card { position: relative; display: flex; align-items: center; margin: 0; }
.mine-page button.shortcut { gap: 12px; min-height: 86px; padding: 14px; box-shadow: 0 2px 0 #eceee7; font-weight: 700; }
.shortcut-icon, .service-icon { display: grid; place-items: center; flex: 0 0 auto; border-radius: 11px; }
.shortcut-icon { width: 38px; height: 38px; background: #fff0e7; }
.shortcut-icon.address-icon { background: #eff2e8; }
.shortcut-icon image, .service-icon image { width: 20px; height: 20px; }
.chevron { flex: 0 0 auto; width: 6px; height: 6px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); }
.shortcut .chevron { position: absolute; top: 17px; right: 14px; color: #aaaea1; }
.mine-page button.rules-card { justify-content: space-between; min-height: 82px; margin-top: 14px; padding-block: 11px; }
.rules-card > image { width: 96px; height: 57px; }
.rules-link { display: flex; align-items: center; gap: 7px; margin-top: 8px; color: #aa4e23; font-size: 11px; }
.service-title { margin: 14px 3px 10px; color: var(--muted); font-size: 11px; font-weight: 700; }
.service-card { padding: 0 14px; }
.mine-page .service-card .menurow { position: relative; justify-content: flex-start; gap: 13px; min-height: 44px; padding: 6px 4px 6px 0; border: 0; font-size: 13px; }
.mine-page .service-card .menurow + .menurow::before { content: ''; position: absolute; top: 0; left: 41px; right: 4px; height: 1px; background: var(--line); }
.service-icon { width: 28px; height: 28px; background: #f4f5ee; }
.menurow .chevron { margin-left: auto; color: var(--muted); }
.mine-page button.logout-btn { display: flex; width: 132px; min-height: 40px; margin: 14px auto 0; color: var(--muted); font-weight: 400; }
