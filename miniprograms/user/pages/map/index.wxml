<view class="page map-page">
  <view class="row map-heading">
    <view class="h2">{{stale ? '位置更新中断' : markers.length ? '骑手正在配送' : '配送位置'}}</view>
    <text class="pill">本订单</text>
  </view>
  <include src="../../templates/load-state.wxml"/>
  <block wx:if="{{!loading && !loadError}}">
    <block wx:if="{{markers.length}}">
      <view class="hint {{stale ? 'orange' : 'green'}}">
        {{stale ? '以下为最后已知位置，并非实时。' : '位置仅用于本订单配送展示。'}}
      </view>
      <view class="map-wrap">
        <map class="native-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}"
          markers="{{markers}}" show-location="{{false}}" enable-scroll="{{true}}" enable-zoom="{{true}}"/>
      </view>
      <view class="card">
        <view class="h3">{{stale ? '最后已知位置' : '骑手位置'}}</view>
        <view class="kv"><text class="label">采集状态</text><text>{{stateText}}</text></view>
        <view class="kv" wx:if="{{hint}}"><text class="label">最近更新</text><text>{{hint}}</text></view>
      </view>
    </block>
    <view wx:else class="empty">
      <view class="symbol"><image src="/assets/pin.svg" aria-hidden="true"/></view>
      <view class="h3">当前无可查看的骑手位置</view>
      <view class="muted">{{stateText}}</view>
    </view>
    <button class="btn secondary wide" bindtap="load">刷新位置</button>
  </block>
</view>
