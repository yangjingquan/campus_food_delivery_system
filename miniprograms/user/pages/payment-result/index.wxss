@import "../../styles/base.wxss";
.successicon.is-pending { background: #fff0e7; color: #a84b21; }
.status-glyph { font-size: 24px; font-weight: 700; line-height: 1; }
.result-order-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
}
.result-order-head .h3 { min-width: 0; }
.result-order-head .orderstate { margin-left: auto; color: #a84b21; overflow-wrap: anywhere; }
.result-pickup { margin-top: 4px; color: #a84b21; font-weight: 600; }
.result-order .kv { margin-top: 8px; }
.price-inline { color: var(--accent); font-weight: 700; font-variant-numeric: tabular-nums; }
.result-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
.result-bottom-actions { display: grid; gap: 10px; }
