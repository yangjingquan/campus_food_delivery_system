@import "../../styles/base.wxss";
.timeline-space { margin-top: 13px; }
.event .small { overflow-wrap: anywhere; }
.event > view:first-child { font-weight: 600; }
.event.is-history::before { background: #c5cabe; }
.event.is-current::before { background: var(--accent); box-shadow: 0 0 0 3px #ffe7d9; }
.aftersale-page .timeline { padding-left: 4px; }
.aftersale-page .column { gap: 11px; }
.aftersale-photo {
  display: block;
  width: 100%;
  height: 160px;
  margin-top: 8px;
  border-radius: 12px;
  background: #f3f4ef;
}
