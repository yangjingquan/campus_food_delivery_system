<view class="page aftersale-page">
  <include src="../../templates/load-state.wxml"/>
  <block wx:if="{{item && !loading && !loadError}}">
    <view class="statusbig">
      <view class="subheading">AFTER-SALES SERVICE</view>
      <view class="h2">{{item.status}}</view>
      <view class="muted">{{stateHint}}</view>
    </view>
    <view wx:if="{{item.originalOnlineFailure}}" class="hint orange">原线上记录：{{item.originalOnlineFailure}}</view>
    <view wx:if="{{item.platformIntervened}}" class="hint">平台已收到介入申请，渠道结果仍会更新。</view>
    <view class="card">
      <view class="h3">本次申请</view>
      <view class="kv"><text class="label">售后单号</text><text>{{item.id}}</text></view>
      <view class="kv"><text class="label">退款金额</text><text>{{amountText}}</text></view>
      <view class="kv"><text class="label">退款类型</text><text>{{item.type === 'partial' ? '部分退款（仅餐品）' : '全额 / 剩余全额'}}</text></view>
      <view class="kv"><text class="label">申请原因</text><text>{{item.reason}}</text></view>
      <view wx:if="{{item.description}}" class="kv"><text class="label">补充说明</text><text>{{item.description}}</text></view>
      <view wx:if="{{createdAtText}}" class="kv"><text class="label">申请时间</text><text>{{createdAtText}}</text></view>
    </view>
    <view class="card">
      <view class="h3">处理记录</view>
      <view class="timeline timeline-space">
        <view wx:for="{{events}}" wx:key="key" class="event">
          <view>{{item.status}}</view>
          <view class="small">{{item.message}}</view>
          <view wx:if="{{item.timeText}}" class="small">{{item.timeText}}</view>
        </view>
        <view class="event">
          <view>{{item.status}}</view>
          <view class="small">当前处理状态</view>
        </view>
      </view>
    </view>
    <view class="column">
      <view wx:if="{{actionError}}" class="error">{{actionError}}</view>
      <button wx:if="{{canIntervene}}" class="btn wide" disabled="{{working}}" bindtap="intervene">申请平台介入</button>
      <button wx:if="{{canEnd}}" class="btn secondary wide" disabled="{{working}}" bindtap="end">结束售后</button>
      <button class="btn outline wide" bindtap="load">刷新进度</button>
      <button class="btn secondary wide" bindtap="back">返回订单</button>
    </view>
  </block>
</view>
