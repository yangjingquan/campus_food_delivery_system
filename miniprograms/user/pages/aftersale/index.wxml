<view class="page" wx:if="{{item}}">
  <view class="statusbig"><view class="subheading">AFTER-SALES SERVICE</view><view class="h2 after-title">{{item.status}}</view><view class="muted">{{stateHint}}</view></view>
  <view wx:if="{{item.originalOnlineFailure}}" class="hint orange">原线上退款失败：{{item.originalOnlineFailure}}。请等待平台线下核实，勿重复申请。</view>
  <view wx:if="{{item.status === '线下已处理'}}" class="hint green">线下处理完成；原线上失败记录继续保留。</view>
  <view class="card"><view class="h3">本次申请</view><view class="kv"><text class="label">售后单号</text><text>{{item.id}}</text></view><view class="kv"><text class="label">期望退款金额</text><text>{{amountText}}</text></view><view class="kv"><text class="label">退款类型</text><text>{{item.type === 'partial' ? '部分退款（仅餐品）' : '全额 / 剩余全额'}}</text></view><view class="kv"><text class="label">申请原因</text><text>{{item.reason}}</text></view><view class="kv"><text class="label">补充说明</text><text>{{item.description || '无'}}</text></view><view class="kv"><text class="label">原履约状态</text><text>{{item.fulfillmentStatus}}</text></view></view>
  <view class="card"><view class="h3">处理记录</view><view class="timeline timeline-space"><view wx:for="{{events}}" wx:key="index" class="event">{{item.status}} · {{item.message}}<view class="small">{{item.timeText}}</view></view><view class="event">{{item.status}}<view class="small">当前处理状态</view></view></view></view>
  <view wx:if="{{canIntervene}}" class="column"><button wx:if="{{item.status === '拒绝退款'}}" class="btn outline wide" bindtap="contact">联系商户</button><button class="btn wide" bindtap="intervene">申请平台介入</button><button wx:if="{{canEnd}}" class="btn secondary wide" bindtap="end">结束售后</button></view>
  <button class="btn outline wide back-btn" bindtap="back">返回订单</button>
</view>
