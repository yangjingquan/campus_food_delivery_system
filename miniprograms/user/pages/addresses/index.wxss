@import "../../styles/base.wxss";
.address-heading { margin-bottom: 18px; }
.address-heading .h2 { margin-bottom: 6px; font-size: 24px; }
.address-top { align-items: flex-start; }
.address-title-row { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
.address-title-row .tag { margin: 0; }
.address-badge { background: #f3f4ef; color: var(--muted); font-weight: 600; }
.address-badge.is-active { background: #fff0e7; color: #a84b21; }
.address-warn { margin-top: 4px; color: #a84b21; }
.address-owner { margin-top: 8px; color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
.address-inline-actions {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}
.addresses-page button.address-icon-btn {
  min-height: 40px;
  padding: 6px 10px;
  border-radius: 10px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}
.addresses-page button.address-icon-btn.is-danger { color: #b43c25; }
