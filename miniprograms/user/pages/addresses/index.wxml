<view class="page addresses-page">
  <view class="address-heading">
    <view class="h2">{{choose ? '选择收餐地址' : '我的收餐地址'}}</view>
    <view class="small">{{choose ? '轻点地址卡片即可选用' : '管理校内宿舍收餐地址'}}</view>
  </view>
  <include src="../../templates/load-state.wxml"/>
  <block wx:if="{{!loading && !loadError}}">
    <view wx:for="{{rows}}" wx:key="id" class="card address {{item.id === selectedId ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="select" hover-class="card-pressed">
      <view class="row address-top">
        <view class="info">
          <view class="address-title-row">
            <text class="h3">{{item.building}} {{item.room}}</text>
            <text wx:if="{{item.isDefault}}" class="tag address-badge">默认</text>
            <text wx:if="{{item.id === selectedId}}" class="tag address-badge is-active">当前使用</text>
          </view>
          <view wx:if="{{item.needsLocation}}" class="small address-warn">待补充地图定位，点击前往设置</view>
          <view class="address-owner">{{item.name}}　{{item.phone}}</view>
        </view>
        <view class="address-inline-actions">
          <button class="address-icon-btn" data-id="{{item.id}}" catchtap="edit" aria-label="编辑地址">编辑</button>
          <button class="address-icon-btn is-danger" data-id="{{item.id}}" catchtap="remove" aria-label="删除地址">删除</button>
        </view>
      </view>
    </view>
    <view wx:if="{{!rows.length}}" class="empty">
      <view class="symbol"><image src="/assets/v3-address.svg" aria-hidden="true"/></view>
      <view class="h3">还没有收餐地址</view>
      <view class="muted">下单前请添加宿舍楼、寝室号与地图入口定位。</view>
    </view>
    <button class="btn wide" bindtap="add">＋ 新增收餐地址</button>
  </block>
  <include src="../../templates/dialog.wxml"/>
</view>
