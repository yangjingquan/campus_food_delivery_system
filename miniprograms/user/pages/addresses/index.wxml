<view class="page">
  <view class="row address-heading"><view class="h2">{{choose ? '选择收餐地址' : '我的收餐地址'}}</view><view class="pill">示例大学</view></view>
  <view wx:for="{{rows}}" wx:key="id" class="card address {{item.isDefault ? 'selected' : ''}}">
    <view class="h3">{{item.building}} {{item.room}}</view><view class="muted address-owner">{{item.name}}　{{item.phone}}</view><view wx:if="{{item.isDefault}}" class="tag">默认地址</view>
    <view class="actions"><button class="btn small-btn {{choose ? '' : 'outline'}}" data-id="{{item.id}}" bindtap="select">{{choose ? '选择此地址' : '使用此地址'}}</button><button class="btn outline small-btn" data-id="{{item.id}}" bindtap="edit">编辑</button><button class="btn outline small-btn" data-id="{{item.id}}" bindtap="remove">删除</button></view>
  </view>
  <view wx:if="{{!rows.length}}" class="hint">还没有收餐地址。下单前请先添加宿舍楼和寝室。</view>
  <button class="btn wide add-address" bindtap="add">＋ 新增收餐地址</button>
</view>
