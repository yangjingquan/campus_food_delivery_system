<view class="page addresses-page">
  <view class="address-heading">
    <view class="h2">{{choose ? '选择收餐地址' : '我的收餐地址'}}</view>
    <view class="small">校内配送</view>
  </view>
  <include src="../../templates/load-state.wxml"/>
  <block wx:if="{{!loading && !loadError}}">
    <view wx:for="{{rows}}" wx:key="id" class="address-entry">
      <view class="card address {{item.id === selectedId ? 'selected' : ''}}">
        <view class="h3">{{item.building}} {{item.room}}</view>
        <view class="address-owner">{{item.name}}　{{item.phone}}</view>
        <view><text wx:if="{{item.isDefault}}" class="tag">默认地址</text><text wx:if="{{item.isDefault && item.id === selectedId}}" class="tag">·</text><text wx:if="{{item.id === selectedId}}" class="tag">当前使用</text></view>
      </view>
      <view class="actions address-actions">
        <button class="btn outline" data-id="{{item.id}}" bindtap="select">
          {{choose ? '选择此地址' : '使用此地址'}}
        </button>
        <button class="btn outline" data-id="{{item.id}}" bindtap="edit">编辑</button>
        <button class="btn outline" data-id="{{item.id}}" bindtap="remove">删除</button>
      </view>
    </view>
    <view wx:if="{{!rows.length}}" class="hint">还没有收餐地址。下单前请填写宿舍楼和寝室号。</view>
    <button class="btn wide" bindtap="add">＋ 新增收餐地址</button>
  </block>
  <include src="../../templates/dialog.wxml"/>
</view>
