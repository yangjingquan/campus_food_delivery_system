<view class="page cart-page">
  <include src="../../templates/load-state.wxml"/>
  <block wx:if="{{!loading && !loadError && cartCount}}">
    <view class="row">
      <view><view class="h2">想吃的，都在这里</view><view class="small">共 {{groups.length}} 家商户 · {{cartCount}} 份餐品</view></view>
      <button class="btn outline small-btn clear-cart" bindtap="clear">清空</button>
    </view>
    <view class="section">
      <view wx:for="{{groups}}" wx:for-index="groupIndex" wx:key="merchantId" class="card">
        <button class="merchant-link" data-id="{{item.merchantId}}" bindtap="openStore">{{item.merchantName}} ›</button>
        <view wx:for="{{item.items}}" wx:for-item="food" wx:key="productId" class="foodline">
          <view class="thumb">
            <image src="{{food.picture}}" mode="aspectFill" data-group="{{groupIndex}}" data-index="{{index}}" binderror="imageError" aria-hidden="true"/>
          </view>
          <view class="info">
            <view class="h3">{{food.name}}</view>
            <view class="row food-price-row">
              <view class="price">{{food.priceText}}</view>
              <view class="stepper">
                <button data-id="{{food.productId}}" data-delta="-1" aria-label="减少一份" bindtap="change">−</button>
                <text>{{food.quantity}}</text>
                <button data-id="{{food.productId}}" data-delta="1" aria-label="增加一份"
                  disabled="{{food.quantity >= food.availableStock || food.quantity >= 99}}" bindtap="change">＋</button>
              </view>
            </view>
          </view>
        </view>
        <view class="row split"><text class="small">本商户固定配送费</text><text>{{item.feeText}}</text></view>
      </view>
    </view>
    <view class="hint">{{groups.length > 1 ? '合并付款后按商户拆单，各店独立出餐、配送与售后。' : '本店独立出餐、配送与售后。'}}</view>
    <view class="card bill">
      <view class="row"><text>餐品金额</text><text>{{foodText}}</text></view>
      <view class="row"><text>配送费（{{groups.length}} 笔）</text><text>{{feeText}}</text></view>
    </view>
    <view class="totalbar">
      <view class="card row totalbar-summary"><view class="small">合计（含配送费）</view><view class="price">{{totalText}}</view></view>
      <button class="btn" bindtap="checkout">去结算</button>
    </view>
  </block>
  <view wx:if="{{!loading && !loadError && !cartCount}}" class="empty">
    <view class="symbol"><image src="/assets/v2-empty-cart.svg" aria-hidden="true"/></view>
    <view class="h3">购物车还空着</view>
    <view class="muted">挑选喜欢的餐品，可单店下单，也可多店合并支付。</view>
    <button class="btn" bindtap="openHome">去选餐</button>
  </view>
  <include src="../../templates/dialog.wxml"/>
</view>
