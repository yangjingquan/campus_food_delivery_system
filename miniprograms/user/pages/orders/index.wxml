<wxs module="states" src="../../utils/states.wxs"/>
<view class="page tab-page orders-page">
  <view class="h2">每一份，都有进度</view>
  <scroll-view class="filters" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="filter-rail">
      <button wx:for="{{filters}}" wx:key="*this" class="chip {{filter === item ? 'on' : ''}}"
        data-value="{{item}}" bindtap="chooseFilter">{{states.label(item)}}</button>
    </view>
  </scroll-view>
  <include src="../../templates/load-state.wxml"/>
  <block wx:if="{{!loading && !loadError}}">
    <view wx:for="{{visible}}" wx:key="id" class="card ordercard" data-id="{{item.id}}" data-payment="{{item.isPayment}}" bindtap="openEntry" hover-class="card-pressed">
      <view class="order-head">
        <view class="h3 order-name">{{item.merchantName}}</view>
        <view class="orderstate">{{states.label(item.displayStatus)}}</view>
      </view>
      <view wx:if="{{item.fulfillmentType === 'pickup'}}" class="small order-note"><text class="tag">到店自取</text></view>
      <view class="muted order-summary">{{item.displayItems}}</view>
      <view wx:if="{{!item.isPayment && item.note}}" class="small order-note">{{item.refundStatus && item.refundStatus !== 'NO_AFTER_SALE' ? '售后：' + states.label(item.refundStatus) : item.note}}</view>
      <view class="order-footer">
        <view class="order-total">
          <text class="small">{{item.isPayment ? '应付金额' : '订单金额'}}</text>
          <text class="order-amount">{{item.amountText}}</text>
        </view>
        <button wx:if="{{item.isPayment}}" class="order-link is-pay" data-id="{{item.id}}" catchtap="openPayment">
          <text>去付款</text>
        </button>
        <button wx:else class="order-link" data-id="{{item.id}}" catchtap="openOrder">
          <text>查看详情</text>
        </button>
      </view>
    </view>
    <view wx:if="{{!visible.length}}" class="empty">
      <view class="symbol"><image src="/assets/v2-empty-order.svg" aria-hidden="true"/></view>
      <view class="h3">还没有相关订单</view>
      <view class="muted">点餐后可以在这里查看进度。</view>
      <button class="btn" bindtap="goHome">去点餐</button>
    </view>
    <view wx:if="{{loadingMore}}" class="small order-list-footer">正在加载更多订单…</view>
    <view wx:elif="{{loadMoreError}}" class="small order-list-footer">
      {{loadMoreError}}
      <button class="link" bindtap="loadMore">重试</button>
    </view>
    <view wx:elif="{{visible.length && !hasMore}}" class="small order-list-footer">没有更多订单</view>
  </block>
</view>
