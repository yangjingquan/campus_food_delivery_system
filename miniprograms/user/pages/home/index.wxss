.home-page .h2 { font-size: 25px; }
.home-page .subheading { margin-bottom: 10px; font-size: 10px; letter-spacing: 0; font-weight: 700; }
.home-page button.address-link { margin-top: 6px; color: var(--ink); }
.hero {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  min-height: 180px;
  margin-top: 11px;
  padding: 18px 19px;
  border-radius: 24px;
  background: #f2e6d3;
}
.hero-copy { flex: 1 1 0; min-width: 0; }
.hero .h1 { font-size: 26px; line-height: 1.3; }
.hero-sub { margin: 9px 0 12px; color: #6e604e; font-size: 10px; }
.home-page .hero .btn { min-width: 115px; }
.hero .art { display: block; flex: 0 0 auto; width: 97px; height: 97px; margin: 11px 3px 0 0; }
.delivery-row { min-height: 48px; }
.delivery-window { color: var(--green); }
.search { display: flex; align-items: center; gap: 10px; min-height: 47px; padding: 0 14px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
.search input { flex: 1 1 0; width: 0; min-width: 0; height: 44px; font-size: 12px; }
.home-page button.search-btn { color: #a84b21; flex: 0 0 auto; font-weight: 700; }
.home-page .section { margin: 15px 0 12px; }
.merchant-count { margin-top: 10px; }
.home-page button.store-card { display: block; min-height: 110px; }
.store-row { display: flex; align-items: flex-start; gap: 14px; width: 100%; }
.store-row .thumb { width: 68px; height: 68px; }
.store-address { margin-top: 5px; overflow-wrap: anywhere; }
.store-state { margin-top: 5px; font-size: 11px; color: var(--muted); }
.store-state.open { color: #a84b21; }

@media (max-width: 350px) {
  .hero { padding-inline: 15px; }
  .hero .art { width: 75px; height: 75px; margin-right: 0; }
  .hero .h1 { font-size: 23px; }
}
