@import "../../styles/base.wxss";
.home-page { padding-bottom: calc(124px + max(15px, env(safe-area-inset-bottom))); }
.home-page .h2 { font-size: 24px; }
.home-page .subheading { margin-bottom: 6px; font-size: 12px; letter-spacing: .5px; font-weight: 600; }
.home-page button.address-link { margin-top: 6px; color: var(--ink); font-size: 13px; }
.hero {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  min-height: 176px;
  margin-top: 11px;
  padding: 18px 19px;
  border-radius: 24px;
  background: #f2e6d3;
}
.hero-copy { flex: 1 1 0; min-width: 0; }
.hero .h1 { font-size: 25px; line-height: 1.3; }
.hero-sub { margin: 8px 0 12px; color: #6e604e; font-size: 12px; }
.home-page .hero .btn { min-width: 115px; }
.hero .art { display: block; flex: 0 0 auto; width: 96px; height: 96px; margin: 10px 2px 0 0; }
.hero-carousel { height: 180px; margin-top: 11px; overflow: hidden; border-radius: 24px; background: #f2e6d3; }
.home-page button.hero-slide, .hero-slide-image { display: block; width: 100%; height: 100%; }
.delivery-row { min-height: 44px; }
.delivery-window { color: var(--green); }
.search { display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
.search input { flex: 1 1 0; width: 0; min-width: 0; height: 44px; font-size: 13px; }
.home-page button.search-clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #edeee8;
  color: var(--muted);
  font-size: 15px;
  line-height: 1;
}
.home-page button.search-btn { color: #a84b21; flex: 0 0 auto; font-size: 13px; font-weight: 700; }
.home-page .section { margin: 15px 0 12px; }
.merchant-count { margin-top: 6px; }
.home-page button.store-card { display: block; }
.home-page button.store-card.is-closed { opacity: .74; }
.store-row { display: flex; align-items: flex-start; gap: 14px; width: 100%; }
.store-row .store-thumb { position: relative; width: 68px; height: 68px; }
.closed-mask {
  position: absolute;
  inset: auto 0 0 0;
  padding: 2px 0;
  background: rgba(41, 44, 41, .68);
  color: #fff;
  font-size: 11px;
  text-align: center;
}
.store-address { margin-top: 4px; overflow-wrap: anywhere; }
.store-state { margin-top: 5px; font-size: 12px; color: var(--muted); }
.store-state.open { color: #a84b21; font-weight: 500; }

@media (max-width: 350px) {
  .hero { padding-inline: 15px; }
  .hero .art { width: 75px; height: 75px; margin-right: 0; }
  .hero .h1 { font-size: 22px; }
}
