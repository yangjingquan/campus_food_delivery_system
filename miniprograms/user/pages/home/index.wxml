<view class="page tab-page home-page">
  <view class="row">
    <view>
      <view class="subheading">HELLO, CAMPUS</view>
      <view class="h2">今天想吃点什么？</view>
    </view>
    <text class="pill">送到寝室</text>
  </view>
  <button class="link address-link" bindtap="chooseAddress">
    <image class="inline-icon" src="/assets/pin.svg" aria-hidden="true"/>
    <text>{{addressLabel}} ›</text>
  </button>

  <swiper wx:if="{{banners.length}}" class="hero-carousel" current="{{currentBanner}}"
    autoplay="{{banners.length > 1}}" circular="{{banners.length > 1}}" indicator-dots="{{banners.length > 1}}"
    indicator-color="rgba(0,0,0,.24)" indicator-active-color="#fff" interval="5000" duration="300" bindchange="bannerChanged">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <button class="hero-slide" data-id="{{item.id}}" bindtap="openBanner" aria-label="{{item.name}}">
        <image class="hero-slide-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}"
          data-image="{{item.image}}" binderror="bannerImageError" aria-hidden="true"/>
      </button>
    </swiper-item>
  </swiper>
  <view wx:else class="hero">
    <view class="hero-copy">
      <view class="h1"><view>下课了，</view><view>好好吃顿饭。</view></view>
      <view class="hero-sub">校外好味道 · 骑手分批送至寝室</view>
      <button class="btn small-btn" bindtap="startOrder">开始点餐 →</button>
    </view>
    <image class="art" src="/assets/v2-hero.svg" mode="aspectFit" aria-hidden="true"/>
  </view>
  <view class="row delivery-row">
    <view class="small delivery-window" wx:if="{{config.serviceStart}}">
      <text>{{config.serviceStart}}–{{config.serviceEnd}} · 分批配送</text>
    </view>
    <button class="link" bindtap="showRules">配送说明 ›</button>
  </view>

  <view class="search" id="catalog">
    <image class="inline-icon" src="/assets/search.svg" aria-hidden="true"/>
    <input value="{{keyword}}" aria-label="搜索商户或餐品" placeholder="搜索商户、想吃的餐品"
      bindinput="inputKeyword" confirm-type="search" bindconfirm="search"/>
    <button wx:if="{{keyword}}" class="search-clear-btn" bindtap="clearKeyword" aria-label="清除搜索词">×</button>
    <button class="link search-btn" bindtap="search">搜索</button>
  </view>
  <scroll-view class="filters" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="filter-rail">
      <button wx:for="{{categories}}" wx:key="*this" class="chip {{category === item ? 'on' : ''}}"
        data-value="{{item}}" bindtap="chooseCategory">{{item}}</button>
    </view>
  </scroll-view>

  <view class="section">
    <view class="h3">校园附近的好味道</view>
    <view class="small merchant-count" wx:if="{{!loading && !loadError}}">{{merchants.length}} 家入驻商户</view>
  </view>
  <include src="../../templates/load-state.wxml"/>
  <block wx:if="{{!loading && !loadError}}">
    <button wx:for="{{merchants}}" wx:key="id" class="card store-card wide {{item.open ? '' : 'is-closed'}}" data-id="{{item.id}}" bindtap="openStore">
      <view class="store-row">
        <view class="thumb store-thumb">
          <image src="{{item.picture}}" mode="aspectFill" lazy-load data-index="{{index}}" binderror="imageError" aria-hidden="true"/>
          <view wx:if="{{!item.open}}" class="closed-mask">休息中</view>
        </view>
        <view class="info">
          <view class="row">
            <view class="h3">{{item.name}}</view>
            <text wx:if="{{!item.open}}" class="tag">暂不接单</text>
          </view>
          <view class="small store-address" wx:if="{{item.address}}">{{item.address}}</view>
          <view class="store-state {{item.open ? 'open' : ''}}">配送费 {{item.deliveryFeeText}} · {{item.open ? '营业中' : '已打烊'}}</view>
        </view>
      </view>
    </button>
    <view wx:if="{{!merchants.length}}" class="empty">
      <view class="symbol"><image src="/assets/v2-empty-home.svg" aria-hidden="true"/></view>
      <view class="h3">没有找到相关商户，换个关键词试试。</view>
      <button wx:if="{{keyword || category !== '全部'}}" class="btn secondary" bindtap="resetFilters">查看全部商户</button>
    </view>
  </block>
  <include src="../../templates/dialog.wxml"/>
</view>
