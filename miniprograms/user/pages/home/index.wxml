<view class="page tab-page home-page">
  <view class="row">
    <view>
      <view class="subheading">HELLO, CAMPUS</view>
      <view class="h2">今天想吃点什么？</view>
    </view>
    <text class="pill">送到寝室</text>
  </view>
  <button class="link address-link" bindtap="chooseAddress">
    <image class="inline-icon" src="/assets/pin.svg" aria-hidden="true"/>
    <text>{{addressLabel}} ›</text>
  </button>

  <view class="hero">
    <view class="hero-copy">
      <view class="h1"><view>下课了，</view><view>好好吃顿饭。</view></view>
      <view class="hero-sub">校外好味道 · 骑手分批送至寝室</view>
      <button class="btn small-btn" bindtap="startOrder">开始点餐 →</button>
    </view>
    <image class="art" src="/assets/rice.svg" mode="aspectFit" aria-hidden="true"/>
  </view>
  <view class="row delivery-row">
    <view class="small delivery-window" wx:if="{{config.serviceStart}}">
      <view class="delivery-dot"></view>
      <text>{{config.serviceStart}}–{{config.serviceEnd}} · 分批配送</text>
    </view>
    <button class="link" bindtap="showRules">配送说明 ›</button>
  </view>

  <view class="search" id="catalog">
    <image class="inline-icon" src="/assets/search.svg" aria-hidden="true"/>
    <input value="{{keyword}}" aria-label="搜索商户或餐品" placeholder="搜索商户、想吃的餐品"
      bindinput="inputKeyword" confirm-type="search" bindconfirm="search"/>
    <button class="link search-btn" bindtap="search">搜索</button>
  </view>
  <scroll-view class="filters" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="filter-rail">
      <button wx:for="{{categories}}" wx:key="*this" class="chip {{category === item ? 'on' : ''}}"
        data-value="{{item}}" bindtap="chooseCategory">{{item}}</button>
    </view>
  </scroll-view>

  <view class="row section">
    <view class="h3">校园附近的好味道</view>
    <text class="small" wx:if="{{!loading && !loadError}}">{{merchants.length}} 家入驻商户</text>
  </view>
  <include src="../../templates/load-state.wxml"/>
  <block wx:if="{{!loading && !loadError}}">
    <button wx:for="{{merchants}}" wx:key="id" class="card store-card wide" data-id="{{item.id}}" bindtap="openStore">
      <view class="store-row">
        <view class="thumb">
          <image src="{{item.picture}}" mode="aspectFill" lazy-load data-index="{{index}}" binderror="imageError" aria-hidden="true"/>
        </view>
        <view class="info">
          <view class="row store-name"><view class="h3">{{item.name}}</view><text wx:if="{{!item.open}}" class="pill">打烊</text></view>
          <view class="small store-address" wx:if="{{item.address}}">{{item.address}}</view>
          <view><text class="tag">每店配送 {{item.deliveryFeeText}}</text><text class="tag">{{item.open ? '营业中' : '暂不接单'}}</text></view>
        </view>
      </view>
    </button>
    <view wx:if="{{!merchants.length}}" class="empty muted">没有找到相关商户，换个关键词试试。</view>
  </block>
</view>
