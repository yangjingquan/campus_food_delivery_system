<wxs module="states" src="../../utils/states.wxs"/>
<view class="page order-detail-page">
  <include src="../../templates/load-state.wxml"/>
  <block wx:if="{{order && !loading && !loadError}}">
    <view class="statusbig">
      <view class="subheading">{{order.merchantName}}</view>
      <view class="h2">{{states.label(order.fulfillStatus)}}</view>
      <view class="muted" wx:if="{{statusNote}}">{{statusNote}}</view>
    </view>

    <view wx:if="{{stepIndex >= 0}}" class="card">
      <view class="h3">{{pickup ? '自取进度' : '配送进度'}}</view>
      <view class="progress" aria-label="当前进度 {{states.label(order.fulfillStatus)}}">
        <view wx:for="{{steps}}" wx:key="*this" class="step {{index <= stepIndex ? 'done' : ''}} {{index === stepIndex ? 'current' : ''}}">
          <view class="step-dot"></view><text>{{item}}</text>
        </view>
      </view>
      <view wx:if="{{!pickup && !order.locationAvailable}}" class="split delivery-progress-footer">
        <view class="small delivery-position-note">{{order.fulfillStatus === 'COMPLETED' ? '订单已完成，位置共享已结束。' : '骑手尚未领取，暂不展示位置。'}}</view>
        <button wx:if="{{order.deliveryPhotoAvailable}}" class="btn small-btn delivery-photo-link"
          loading="{{photoLoading}}" disabled="{{photoLoading}}" bindtap="previewDeliveryPhoto">查看送达照片</button>
      </view>
    </view>
    <delivery-map wx:if="{{!pickup && order.locationAvailable}}" order-id="{{order.id}}" bind:ended="refreshAfterDelivery"/>

    <button wx:for="{{aftersales}}" wx:key="id" class="card wide aftersale-link" data-id="{{item.id}}" bindtap="afterSale">
      <view class="row">
        <view>
          <view class="h3">售后 · {{states.label(item.status)}}</view>
          <view class="small aftersale-amount">本次退款金额 {{item.amountText}}</view>
        </view>
        <text>›</text>
      </view>
    </button>

    <view class="card">
      <view class="h3">{{order.merchantName}}</view>
      <view wx:for="{{items}}" wx:key="productId" class="row order-item">
        <view>{{item.name}} <text class="small">× {{item.quantity}}</text></view><text class="item-amount">{{item.amountText}}</text>
      </view>
      <view class="split">
        <view class="kv"><text class="label">餐品金额</text><text>{{foodText}}</text></view>
        <view wx:if="{{!pickup}}" class="kv"><text class="label">配送费</text><text>{{feeText}}</text></view>
        <view class="kv"><text class="label">{{order.mergedPaymentStatus === 'PAYMENT_SUCCEEDED' ? '订单实付' : '订单金额'}}</text><text>{{amountText}}</text></view>
        <view wx:if="{{order.refundedCents}}" class="kv"><text class="label">累计已退</text><text>{{refundedText}}</text></view>
      </view>
    </view>
    <view class="card">
      <view class="h3">订单信息</view>
      <view wx:if="{{pickup}}" class="kv"><text class="label">取餐地点</text><text>{{order.pickupAddress}}</text></view>
      <view wx:if="{{pickup && order.pickupCode}}" class="kv"><text class="label">取餐号</text><text selectable>{{order.pickupCode}}</text></view>
      <view wx:if="{{!pickup}}" class="kv"><text class="label">收餐地址</text><text>{{order.building}} {{order.room}}</text></view>
      <view wx:if="{{!pickup}}" class="kv"><text class="label">收餐人</text><text>{{order.receiverName}}{{order.phone ? '　' + order.phone : ''}}</text></view>
      <view class="kv"><text class="label">订单号</text><text>{{order.id}}</text></view>
      <view class="kv"><text class="label">支付记录单号</text><text>{{order.paymentId}}</text></view>
      <view wx:if="{{paidAtText}}" class="kv"><text class="label">付款时间</text><text>{{paidAtText}}</text></view>
    </view>
    <button class="btn outline wide copy-link" data-value="{{order.id}}" bindtap="copy">复制订单号</button>
    <button wx:if="{{order.mergedPaymentStatus === 'UNPAID'}}" class="btn wide" bindtap="pay">查看支付单</button>
    <button wx:elif="{{refund.allowed}}" class="btn outline wide" bindtap="refund">申请退款 / 售后</button>
    <view wx:elif="{{refund.reason}}" class="hint">{{refund.reason}}</view>
  </block>
</view>
