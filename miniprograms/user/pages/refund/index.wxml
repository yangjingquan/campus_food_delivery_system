<view class="page refund-page">
  <include src="../../templates/load-state.wxml"/>
  <view wx:if="{{order && !refund.allowed && !loadError}}" class="hint">{{refund.reason}}</view>
  <block wx:if="{{order && refund.allowed && !loading && !loadError}}">
    <view class="h2">{{refund.canPartial ? '申请退款 / 售后' : '申请全额退款'}}</view>
    <view class="muted refund-intro">
      {{refund.canPartial ? '填写期望退款金额，提交后可查看处理进度。' : '提交后可查看退款处理进度。'}}
    </view>
    <view class="card">
      <view class="kv"><text class="label">原餐品金额</text><text>{{foodText}}</text></view>
      <view class="kv"><text class="label">配送费</text><text>{{feeText}}</text></view>
      <view class="kv"><text class="label">原订单实付</text><text>{{paidText}}</text></view>
      <view class="kv"><text class="label">累计已退</text><text>{{refundedText}}</text></view>
      <view class="kv"><text class="label">剩余可退餐品</text><text>{{remainingFoodText}}</text></view>
      <view class="kv"><text class="label">剩余可退实付</text><text>{{remainingPaidText}}</text></view>
    </view>
    <view wx:if="{{refund.canPartial}}" class="refund-options">
      <button class="chip {{type === 'partial' ? 'on' : ''}}" data-value="partial" bindtap="chooseType">部分退款 · 仅餐品</button>
      <button class="chip {{type === 'full' ? 'on' : ''}}" data-value="full" bindtap="chooseType">全额 / 剩余全额</button>
    </view>
    <view class="field">
      <label for="refund-amount">期望退款金额（元）</label>
      <input id="refund-amount" type="digit" value="{{amount}}" disabled="{{type === 'full'}}" bindinput="inputAmount" placeholder="0.00"/>
    </view>
    <view class="field">
      <label>申请原因</label>
      <picker range="{{reasons}}" value="{{reasonIndex}}" bindchange="chooseReason">
        <view class="picker-value row"><text>{{reasons[reasonIndex]}}</text><text aria-hidden="true">⌄</text></view>
      </picker>
    </view>
    <view class="field">
      <label for="refund-description">补充说明（选填）</label>
      <textarea id="refund-description" maxlength="500" bindinput="inputDescription" placeholder="例如：收到的餐品与所选不符，希望协商处理。"/>
    </view>
    <view class="hint orange">部分退款仅退餐品金额。退款实际成功后，本商户订单关闭并停止后续配送。</view>
    <view wx:if="{{error}}" class="error refund-error">{{error}}</view>
    <button class="btn wide" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交申请</button>
  </block>
</view>
