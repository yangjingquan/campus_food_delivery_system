page {
  --orange: #ee692f;
  --ink: #252722;
  --muted: #86867c;
  --bg: #f6f5ef;
  --line: #e9e7df;
  --green: #277c59;
  color: var(--ink);
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}
view, text, button, input, textarea, picker { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; background: transparent; color: inherit; line-height: inherit; font-size: inherit; }
button::after { border: 0; }
input, textarea { font-size: 28rpx; }
.page { min-height: 100vh; padding: 30rpx 34rpx 48rpx; }
.subheading { color: var(--muted); font-size: 20rpx; letter-spacing: 4rpx; }
.h1 { font-size: 48rpx; line-height: 1.25; letter-spacing: -2rpx; font-weight: 750; }
.h2 { font-size: 46rpx; line-height: 1.3; letter-spacing: -1rpx; font-weight: 720; }
.h3 { font-size: 32rpx; font-weight: 680; }
.muted { color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.small { color: var(--muted); font-size: 24rpx; line-height: 1.55; }
.pill { display: inline-flex; align-items: center; border-radius: 14rpx; padding: 8rpx 14rpx; background: #fff0e4; color: #ba5425; font-size: 21rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.column { display: flex; flex-direction: column; gap: 14rpx; }
.section { margin: 38rpx 0 20rpx; }
.card { background: #fff; border: 2rpx solid #eeede7; border-radius: 30rpx; padding: 30rpx; margin: 22rpx 0; }
.hero { position: relative; overflow: hidden; min-height: 335rpx; padding: 42rpx 34rpx; margin: 34rpx 0; border-radius: 38rpx; background: #eaeedb; }
.hero-copy { position: relative; z-index: 2; color: var(--ink); }
.hero .h1 { font-size: 52rpx; }
.hero .art { position: absolute; right: 10rpx; bottom: 2rpx; font-size: 142rpx; opacity: .9; transform: rotate(-12deg); }
.btn { min-height: 88rpx; display: inline-flex; align-items: center; justify-content: center; padding: 0 32rpx; border-radius: 22rpx; background: var(--orange); color: white; font-weight: 680; }
.btn.secondary { color: var(--ink); background: #f1f1e9; }
.btn.outline { color: var(--ink); border: 2rpx solid var(--line); background: #fff; }
.btn.danger { color: #bc4b25; background: #fff1eb; }
.btn.small-btn { min-height: 68rpx; padding: 0 25rpx; font-size: 23rpx; }
.wide { width: 100%; }
.price { color: #df5c29; font-size: 38rpx; font-weight: 760; }
.search { display: flex; align-items: center; height: 88rpx; border: 2rpx solid var(--line); border-radius: 24rpx; padding: 0 22rpx; margin: 28rpx 0 20rpx; background: #fff; }
.search input { flex: 1; min-width: 0; padding: 0 16rpx; font-size: 25rpx; }
.search-btn { flex: 0 0 auto; color: var(--orange); font-weight: 650; white-space: nowrap; }
.filters { display: flex; gap: 16rpx; overflow-x: auto; white-space: nowrap; margin: 22rpx 0 30rpx; }
.chip { flex: 0 0 auto; padding: 14rpx 25rpx; border-radius: 40rpx; background: #eaece3; font-size: 22rpx; white-space: nowrap; }
.chip.on { color: #fff; background: var(--ink); }
.store-card { display: flex; align-items: center; gap: 24rpx; text-align: left; }
.thumb { width: 172rpx; height: 164rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 24rpx; background: #f6ecdc; font-size: 74rpx; }
.info { flex: 1; min-width: 0; }
.tag { display: inline-flex; margin: 10rpx 8rpx 0 0; padding: 6rpx 12rpx; border-radius: 8rpx; color: #76796b; background: #f3f4ef; font-size: 19rpx; }
.foodline { display: flex; align-items: center; gap: 20rpx; }
.stepper { display: flex; align-items: center; gap: 18rpx; }
.stepper button { width: 52rpx; height: 52rpx; border-radius: 16rpx; color: #fff; background: var(--orange); font-size: 32rpx; line-height: 48rpx; }
.bill { display: flex; flex-direction: column; gap: 22rpx; }
.totalbar { position: sticky; bottom: 0; padding: 22rpx 26rpx; margin: 28rpx -34rpx -18rpx; background: #fff; box-shadow: 0 -8rpx 26rpx #2527220b; }
.totalbar .btn { min-width: 240rpx; }
.hint { padding: 22rpx 24rpx; margin: 18rpx 0; border-radius: 18rpx; color: #5f6456; background: #f0f1e9; font-size: 23rpx; line-height: 1.55; }
.hint.green { color: #27634a; background: #edf5ef; }
.hint.orange { color: #986133; background: #fff0de; }
.field { display: flex; flex-direction: column; gap: 12rpx; margin: 24rpx 0; }
.field label { color: #77796e; font-size: 23rpx; }
.field input, .field textarea { width: 100%; min-height: 84rpx; padding: 22rpx; border: 2rpx solid var(--line); border-radius: 18rpx; background: #fff; }
.field textarea { min-height: 180rpx; }
.line { height: 2rpx; background: var(--line); margin: 20rpx 0; }
.kv { display: flex; justify-content: space-between; gap: 20rpx; padding: 13rpx 0; font-size: 23rpx; }
.kv .label { color: var(--muted); }
.statusbig { text-align: center; padding: 48rpx 0 34rpx; }
.successicon { width: 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto 24rpx; border-radius: 50%; color: #fff; background: var(--green); font-size: 56rpx; }
.orderstate { padding: 8rpx 14rpx; color: #a7552b; background: #fff0e4; border-radius: 12rpx; font-size: 21rpx; }
.actions { display: flex; gap: 14rpx; margin-top: 22rpx; }
.actions .btn { flex: 1; }
.empty { text-align: center; padding: 110rpx 25rpx; }
.address.selected { border-color: #ed8a57; background: #fffaf6; }
.timeline { border-left: 2rpx solid #e4e2d9; margin-left: 12rpx; padding-left: 28rpx; }
.event { position: relative; padding: 0 0 28rpx; font-size: 24rpx; }
.event::before { content: ''; position: absolute; left: -37rpx; top: 8rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--orange); }
.map-wrap { height: 650rpx; overflow: hidden; border-radius: 28rpx; margin: 22rpx 0; background: #e7ebdb; }
.map-label { position: absolute; z-index: 2; top: 28rpx; left: 28rpx; padding: 10rpx 16rpx; border-radius: 10rpx; background: #fff; font-size: 21rpx; }
.profile { padding: 32rpx 0 25rpx; }
.avatar { width: 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; border-radius: 50%; color: #fff; background: #e7a57b; font-size: 42rpx; }
.menurow { width: 100%; display: flex; justify-content: space-between; padding: 28rpx 0; border-bottom: 2rpx solid #f0efe9; text-align: left; }
.menurow:last-child { border-bottom: 0; }
.foot { color: #999a91; text-align: center; font-size: 20rpx; line-height: 1.7; padding: 28rpx 0; }
.error { min-height: 32rpx; color: #bd4e2a; font-size: 23rpx; }
.tab-page { padding-bottom: 44rpx; }
