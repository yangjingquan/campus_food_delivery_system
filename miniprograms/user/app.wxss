page {
  --ink: #292c29;
  --muted: #626961;
  --surface: #fff;
  --bg: #f6f5f0;
  --line: #ecede7;
  --accent: #ee692f;
  --action: #ee692f;
  --green: #418268;
  --gutter: 16px;
  --tab-clearance: 151px;
  color: var(--ink);
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  line-height: 1.5;
}

view, text, button, input, textarea, picker, scroll-view, image, map { box-sizing: border-box; }

/* 小程序按钮保留原生点击和禁用语义。宽度由具体布局角色决定。 */
.page button {
  width: auto;
  max-width: none;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: inherit;
  border-radius: 0;
}
.page button::after { border: 0; }
.page button.button-hover { opacity: .78; }
.page button[disabled] { opacity: .45; }
.page button.wide { width: 100%; }
.page button.link { display: inline-flex; align-items: center; gap: 4px; min-height: 40px; color: var(--muted); font-size: 12px; text-align: left; }
.page button.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 8px 16px;
  border-radius: 14px;
  background: var(--action);
  color: #fff;
  font-size: 14px;
  font-weight: 650;
  line-height: 1.35;
  white-space: normal;
}
.page button.btn.small-btn { min-height: 34px; padding: 7px 12px; border-radius: 11px; font-size: 11px; }
.page button.btn.secondary { background: var(--surface); color: var(--ink); border: 1px solid var(--line); }
.page button.btn.outline { border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
.page button.btn.danger { background: #fff1eb; color: #a23a1b; }

.page {
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  padding: 18px var(--gutter) calc(25px + env(safe-area-inset-bottom));
}
.tab-page { padding-bottom: calc(var(--tab-clearance) + max(15px, env(safe-area-inset-bottom))); }
.h1, .h2, .h3 { overflow-wrap: anywhere; }
.h1 { font-size: 26px; font-weight: 750; line-height: 1.25; letter-spacing: -.4px; }
.h2 { font-size: 23px; font-weight: 720; line-height: 1.3; letter-spacing: -.5px; }
.h3 { font-size: 16px; font-weight: 680; line-height: 1.4; }
.subheading { display: block; margin-bottom: 5px; color: var(--muted); font-size: 11px; line-height: 1.4; letter-spacing: 1px; }
.muted, .small { color: var(--muted); font-size: 12px; line-height: 1.6; }
.pill { display: inline-block; flex-shrink: 0; border-radius: 13px; padding: 5px 10px; background: #fff0e7; color: #a64b25; font-size: 11px; line-height: 1.4; white-space: nowrap; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.row > view:first-child, .info { min-width: 0; overflow-wrap: anywhere; }
.column { display: flex; flex-direction: column; gap: 10px; }
.section { margin: 21px 0 12px; }
.card, .page button.card {
  width: 100%;
  margin: 0 0 12px;
  padding: 15px;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: var(--surface);
}
.page button.card { text-align: left; }
.price { color: var(--accent); font-size: 19px; font-weight: 750; font-variant-numeric: tabular-nums; white-space: nowrap; }
.tag { display: inline-block; padding: 3px 6px; margin: 4px 4px 0 0; border-radius: 4px; color: #575b4d; background: #f3f4ef; font-size: 11px; line-height: 1.4; white-space: nowrap; }
.thumb { width: 86px; height: 82px; flex: 0 0 auto; overflow: hidden; border-radius: 15px; background: #f8ecd9; }
.thumb image { display: block; width: 100%; height: 100%; }
.info { flex: 1 1 0; }
.foodline { display: flex; align-items: center; gap: 10px; min-width: 0; }
.foodline .thumb { width: 64px; height: 64px; }
.foodline .h3 { font-size: 14px; }
.foodline + .foodline { margin-top: 12px; }
.food-price-row { margin-top: 5px; }
.stepper { display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0; }
.page .stepper button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: #f0f1eb;
  color: var(--ink);
  font-size: 18px;
}
.page .stepper button:last-child { background: var(--action); color: #fff; }
.stepper text { min-width: 16px; text-align: center; font-variant-numeric: tabular-nums; }

.filters { display: block; width: 100%; margin: 12px 0 16px; white-space: nowrap; }
.filter-rail { display: inline-flex; flex-wrap: nowrap; align-items: center; gap: 8px; vertical-align: top; }
.page button.chip {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  min-height: 32px;
  padding: 6px 11px;
  border-radius: 999px;
  background: #edeee8;
  color: var(--muted);
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
}
.page button.chip.on { background: #fff0e7; color: #a84b21; font-weight: 700; }

.split { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); }
.bill .row + .row { margin-top: 10px; }
.bill .row { font-size: 13px; }
/* V2 将金额摘要与操作分成两行，随正文一起滚动。 */
.page .totalbar { display: grid; gap: 12px; margin-top: 12px; }
.totalbar-summary { min-height: 61px; margin: 0; padding: 12px 15px; }
.totalbar .btn { width: 100%; }
.hint { position: relative; min-height: 45px; margin: 0 0 12px; padding: 12px 14px 12px 38px; border-radius: 14px; background: #edefe9; color: #516957; font-size: 12px; line-height: 1.65; }
.hint::before { content: "i"; position: absolute; left: 15px; top: 15px; width: 12px; height: 12px; border: 1px solid currentColor; border-radius: 50%; font-size: 9px; font-weight: 700; line-height: 11px; text-align: center; }
.hint.green { background: #edf5ef; color: #366447; }
.hint.orange { background: #fff0e7; color: #874723; }

.field { display: flex; flex-direction: column; gap: 7px; margin: 15px 0; }
.field label { font-size: 12px; color: var(--muted); }
.field input, .field textarea, .picker-value { width: 100%; min-height: 48px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); font: inherit; }
.field textarea { min-height: 100px; }
.field input:focus, .field textarea:focus { border-color: var(--accent); }
.error { color: #a93b1b; font-size: 12px; line-height: 1.6; }
.kv { display: flex; justify-content: space-between; gap: 12px; margin: 10px 0; font-size: 12px; line-height: 1.6; }
.kv:last-child { margin-bottom: 0; }
.kv .label { color: var(--muted); flex: 0 0 auto; }
.kv text:last-child { min-width: 0; text-align: right; overflow-wrap: anywhere; }
.statusbig { padding: 12px 0 20px; }
.statusbig .h2 { font-size: 27px; margin: 5px 0; }
.successicon { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; margin-bottom: 16px; border-radius: 20px; background: #e7f2e9; color: #39764b; }
.successicon image { width: 28px; height: 28px; }
.orderstate { flex: 0 0 auto; max-width: 46%; color: var(--accent); font-size: 12px; line-height: 1.35; text-align: right; }
.actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.empty { padding: 30px 0 12px; text-align: center; }
.empty .h3 { font-size: 18px; }
.empty .muted { margin: 12px 0 17px; }
.empty > .btn { width: 100%; }
.address.selected { border-color: var(--accent); }
.timeline { padding: 5px 0 5px 10px; }
.event { position: relative; border-left: 1px solid #dfe3d8; padding: 0 0 17px 16px; font-size: 13px; line-height: 1.65; }
.event:last-child { padding-bottom: 0; }
.event::before { content: ''; position: absolute; left: -4px; top: 6px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
.profile { display: flex; align-items: center; gap: 12px; padding: 20px 0; }
.avatar { width: 56px; height: 56px; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 20px; background: #e5ead6; color: #586642; font-size: 22px; font-weight: 700; }
.page button.menurow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  min-height: 48px;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
  text-align: left;
}
.page button.menurow:last-child { border-bottom: 0; }
.load-state { margin-bottom: 12px; }
.load-state > .btn { margin-top: 24px; }
.inline-icon { display: block; width: 15px; height: 15px; flex: 0 0 auto; }

@media (max-width: 350px) {
  page { --gutter: 13px; }
  .card, .page button.card { padding: 12px; }
  .foodline .thumb { width: 54px; height: 54px; }
}

.symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74px;
  height: 74px;
  margin: 0 auto 20px;
  border-radius: 25px;
  background: #f2e8da;
}
.symbol image { width: 28px; height: 28px; }

.dialog-scrim {
  position: fixed;
  z-index: 50;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(32,40,35,.3);
}
.dialog-panel {
  width: 306px;
  max-width: 100%;
  padding: 24px 20px 9px;
  border-radius: 24px;
  background: var(--surface);
  text-align: center;
}
.dialog-title { font-size: 17px; font-weight: 700; }
.dialog-content { margin: 13px 0 10px; color: var(--muted); font-size: 13px; line-height: 1.62; overflow-wrap: anywhere; }
.dialog-options { display: grid; gap: 2px; margin: 10px 0; }
.page button.dialog-option { min-height: 38px; border-radius: 10px; color: var(--muted); font-size: 13px; }
.page button.dialog-option.on { color: #a84b21; background: #fff0e7; font-weight: 700; }
.dialog-actions { display: flex; margin: 11px -20px 0; }
.page .dialog-actions button { flex: 1 1 0; min-height: 48px; font-weight: 700; }
.page button.dialog-confirm { color: #a84b21; }
.page button.dialog-cancel { color: var(--muted); }
