function label(code) {
  return labels[code] || code || '';
}

var interventionLabels = {
  REFUND_CHANNEL_UNCONFIGURED: '退款渠道未配置，需线下核实',
  REFUND_LIMIT_REACHED: '合并支付单退款次数达到微信侧限制'
};

function intervention(code) {
  return interventionLabels[code] || label(code);
}

module.exports = { label: label, intervention: intervention };
