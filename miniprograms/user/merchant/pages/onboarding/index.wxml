<wxs module="states" src="../../utils/states.wxs"/>
<import src="../../fragments/states.wxml" />
<view class="screen onboarding-screen">
  <view class="heading">{{record && record.auditStatus === 'APPROVED' ? '店铺资料' : '商户入驻'}}</view>
  <view class="hint">提交店铺资料，由平台管理员审核</view>
  <template is="state" data="{{error: loggedIn ? error : '', loading}}" />
  <view wx:if="{{!loggedIn && !loading}}" class="hero">
    <view class="section">登录商户工作台</view>
    <view class="hint muted">使用当前微信账号管理店铺订单、商品和收入。</view>
    <button class="btn wide separator" bindtap="login" loading="{{saving}}" disabled="{{saving}}" hover-class="pressed">微信登录</button>
  </view>
  <view wx:if="{{record && !loading}}" class="card store-summary">
    <view class="row"><text class="section">{{record.name}}</text><text class="badge">{{states.label(record.auditStatus)}}</text></view>
    <view wx:if="{{record.auditReason}}" class="notice">{{record.auditReason}}</view>
    <view wx:if="{{revision}}" class="notice">资料变更：{{states.label(revision.status)}} {{revision.reason}}</view>
    <view wx:if="{{record.auditStatus === 'PENDING_REVIEW'}}" class="hint">审核通过后即可发布商品、接单和查看账户。</view>
    <block wx:if="{{!editable}}">
      <view class="kv"><text>联系人</text><text>{{record.contact}}</text></view>
      <view class="kv"><text>联系电话</text><text>{{record.phone}}</text></view>
      <view class="kv"><text>店铺地址</text><text>{{record.address}}</text></view>
      <image wx:if="{{photo}}" class="store-photo" src="{{photo}}" mode="widthFix" bindload="photoLoaded"
        style="width: {{photoWidth ? photoWidth + 'px' : '100%'}}" aria-label="店铺图片" />
    </block>
    <button wx:if="{{!editable && record.auditStatus === 'APPROVED'}}" class="btn primary wide separator" bindtap="workbench" hover-class="pressed">进入订单工作台</button>
    <button wx:elif="{{!editable}}" class="btn plain centered separator" bindtap="refresh" hover-class="pressed">刷新审核状态</button>
  </view>
  <view wx:if="{{loggedIn && !record && !loading && !error}}" class="card store-summary">
    <view class="row"><text class="section">入驻状态</text><text class="badge neutral">未申请</text></view>
    <view class="hint">填写并提交店铺资料后，可在此查看审核进度。</view>
  </view>
  <view wx:if="{{loggedIn && editable && !loading && !error}}" class="card">
    <view class="section">{{record && record.auditStatus === 'APPROVED' ? '提交资料变更' : '填写入驻资料'}}</view>
    <view class="form-section">基本信息</view>
    <text class="label">店铺名称</text><input aria-label="店铺名称" class="field" data-field="name" bindinput="input" value="{{form.name}}" maxlength="120" />
    <view class="form-section">联系方式</view>
    <text class="label">联系人</text><input aria-label="联系人" class="field" data-field="contact" bindinput="input" value="{{form.contact}}" maxlength="80" />
    <text class="label">联系电话</text><input aria-label="联系电话" class="field" type="number" data-field="phone" bindinput="input" value="{{form.phone}}" maxlength="20" />
    <text class="label">店铺地址</text><input aria-label="店铺地址" class="field" data-field="address" bindinput="input" value="{{form.address}}" maxlength="255" />
    <text class="form-section">店铺图片</text>
    <image wx:if="{{photo}}" class="store-photo" src="{{photo}}" mode="widthFix" bindload="photoLoaded" bindtap="choosePhoto"
      style="width: {{photoWidth ? photoWidth + 'px' : '100%'}}" aria-label="店铺图片" />
    <button wx:else class="photo-picker" bindtap="choosePhoto" hover-class="pressed">
      <view class="photo-plus">＋</view>
      <text class="photo-picker-label">点击上传店铺图片</text>
      <text class="hint">JPEG 或 PNG，最大 1 MB</text>
    </button>
    <view wx:if="{{photoError}}" class="hint">{{photoError}}</view>
    <button wx:if="{{photo}}" class="btn plain separator" bindtap="choosePhoto" hover-class="pressed">更换店铺图片</button>
    <button class="btn primary wide separator" bindtap="save" loading="{{saving}}" disabled="{{saving}}" hover-class="pressed">提交审核</button>
  </view>
  <view wx:if="{{formError}}" class="notice error" aria-live="polite">{{formError}}</view>
  <button class="btn plain centered separator" bindtap="openRolePicker" hover-class="pressed">切换角色</button>
</view>
