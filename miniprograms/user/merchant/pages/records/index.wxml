<wxs module="states" src="../../utils/states.wxs"/>
<import src="../../fragments/states.wxml" />
<include src="../../fragments/role-gate.wxml"/>
<block wx:if="{{roleReady}}">
<view class="screen records-screen">
  <view class="heading">{{title}}</view>
  <view class="hint">显示最近 100 条本店记录</view>
  <template is="state" data="{{error, loading}}" />
  <view wx:if="{{!error && !loading && !rows.length}}" class="card empty muted">暂无记录</view>
  <block wx:if="{{!error && !loading}}">
    <view wx:for="{{rows}}" wx:key="id" class="card record-card {{kind}}">
      <block wx:if="{{kind === 'withdrawals'}}">
        <view class="row summary"><text class="price">{{item.amount}}</text><text class="badge">{{states.label(item.status)}}</text></view>
        <view class="hint">{{item.time}}</view>
        <view class="kv withdrawal-id"><text>申请编号</text><text class="mono" selectable>{{item.id}}</text></view>
        <view wx:if="{{item.reason && item.status !== 'AWAITING_CONFIRMATION'}}" class="notice">{{item.reason}}</view>
        <button wx:if="{{item.canConfirm}}" class="btn primary separator" data-id="{{item.id}}"
          disabled="{{!!confirmingId}}" loading="{{confirmingId === item.id}}" bindtap="confirmWithdrawal">
          确认收款
        </button>
      </block>
      <block wx:elif="{{kind === 'settlements'}}">
        <view class="row summary"><text class="section">订单结算</text><text class="badge {{item.status === 'PENDING_CREDIT' ? 'warn' : ''}}">{{states.label(item.status)}}</text></view>
        <view class="kv"><text>餐品实付</text><text>{{item.food}}</text></view>
        <view class="kv"><text>餐品已退款</text><text>{{item.refunded}}</text></view>
        <view wx:if="{{item.foodRefundedCents}}" class="kv"><text>剩余餐品金额</text><text>{{item.foodBase}}</text></view>
        <view wx:if="{{item.settlementBaseAt}}" class="kv"><text>结算计时起点</text><text>{{item.time}}</text></view>
        <view wx:if="{{item.settlementBaseAt && item.settlementWaitMinutes != null}}" class="kv"><text>等待时长</text><text>{{item.settlementWaitMinutes}} 分钟</text></view>
        <view wx:if="{{item.eligibleAt && !item.settledAt}}" class="kv"><text>预计可提现</text><text>{{item.eligibleTime}}</text></view>
        <view wx:if="{{item.foodRule}}" class="kv"><text>餐品抽成规则</text><text>{{item.foodRule}}</text></view>
        <view wx:if="{{item.foodCommission}}" class="kv"><text>餐品实际抽成</text><text>{{item.foodCommission}}</text></view>
        <view wx:if="{{item.status === 'CLOSED' && !item.net}}" class="kv"><text>商户应得</text><text>¥0.00</text></view>
        <view wx:if="{{item.net}}" class="kv settled"><text>商户入账</text><text>{{item.net}} · {{item.netTime}}</text></view>
        <button class="btn plain align-end separator" data-id="{{item.id}}" bindtap="order" hover-class="pressed">查看订单</button>
      </block>
      <block wx:elif="{{kind === 'debts'}}">
        <view class="row summary"><text class="section">待扣回</text><text class="price">{{item.debt}}</text></view>
        <view class="kv"><text>骑手应得</text><text>{{item.riderAmount}}</text></view>
        <view class="kv"><text>平台垫付</text><text>{{item.advance}}</text></view>
        <view class="kv"><text>已扣回</text><text>{{item.recovered}}</text></view>
        <view wx:if="{{item.note}}" class="hint">{{item.note}}</view>
        <button class="btn plain align-end separator" data-id="{{item.orderId}}" bindtap="order" hover-class="pressed">查看关联订单</button>
      </block>
      <block wx:else>
        <view class="row summary"><text class="section">{{item.label}}</text><text class="muted">{{item.time}}</text></view>
        <view class="kv"><text>可用变动</text><text>{{item.available}}</text></view>
        <view class="kv"><text>冻结变动</text><text>{{item.frozen}}</text></view>
        <view class="kv"><text>关联单号</text><text class="mono" selectable>{{item.referenceId}}</text></view>
      </block>
    </view>
  </block>
</view>
</block>
