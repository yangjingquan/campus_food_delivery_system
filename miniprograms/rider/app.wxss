page {
  --green: #147b58;
  --ink: #18352c;
  --muted: #64786e;
  --background: #f4f7f5;
  --line: #e6ece8;
  --soft: #edf4ef;
  --segment: #e7efe9;
  --red: #a5443a;
  --amber: #805c20;
  --gutter: 16px;
  --card-radius: 16px;
  --card-shadow: 0 8px 24px rgba(30, 55, 40, .06);
  background: var(--background);
  color: var(--ink);
  font: 14px/1.5 -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

view, button, input, image, map, text, scroll-view { box-sizing: border-box; }
/* 微信原生 button 默认会居中并设置宽度，页面布局按控件角色明确分配。 */
.page button, .modal-layer button {
  width: auto;
  min-width: 0;
  max-width: none;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  text-align: left;
}
button::after { border: 0; }
button[disabled] { opacity: .7; }
button[loading]::before { margin-right: 5px; }
.pressed { opacity: .76; }

.page {
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  padding: 16px var(--gutter) calc(14px + env(safe-area-inset-bottom));
}
.root-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
}
.root-content { flex: 1 0 auto; }
.root-footer { flex: none; margin-top: 28px; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.flex-fill { flex: 1; min-width: 0; }
.center { text-align: center; }
.full { width: 100%; }
.no-top { margin-top: 0 !important; }
.top-space, .page button.top-space { margin-top: 10px; }
.muted, .label, .date, .shop, .items { color: var(--muted); }
.small, .label, .shop, .items { font-size: 12px; }
.tiny, .date { font-size: 11px; }
.h2 { font-size: 24px; line-height: 1.26; font-weight: 750; margin: 3px 0 6px; }
.h3 { font-size: 18px; line-height: 1.35; font-weight: 700; }
.b, .strong { font-weight: 700; }
.welcome { margin-bottom: 12px; }
.welcome .h2 { margin: 4px 0 8px; }
.page-heading { margin-bottom: 16px; }
.page-heading .h2 { font-size: 22px; }
.sectiontitle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  font-size: 16px;
  font-weight: 700;
  margin: 18px 0 9px;
}
.sectiontitle .muted { font-weight: 400; }
.page .link {
  display: inline-flex;
  align-items: center;
  color: var(--green);
  font-size: 13px;
  font-weight: 700;
  line-height: 1.5;
  padding: 2px 0;
}

.icon { width: 18px; height: 18px; flex: none; vertical-align: middle; }
.icon-small { width: 15px; height: 15px; }
.icon-large { width: 40px; height: 40px; }
.arrow { color: var(--muted); font-size: 17px; flex: none; }
.chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
  min-height: 22px;
  padding: 2px 12px;
  border-radius: 8px;
  background: #e6f2ec;
  color: var(--green);
  white-space: nowrap;
  font-size: 11px;
  font-weight: 700;
}
.chip.gray { color: #526a5e; background: #ebefed; }
.chip.amber { color: var(--amber); background: #fbf3e6; }
.dot { display: none; width: 4px; height: 4px; border-radius: 50%; background: currentColor; }
.details-title { text-align: center; margin: 0 0 12px; }
.details-title .chip { display: flex; width: 100%; padding-left: 8px; }
.details-title .dot { display: block; }
.order-status { margin-top: 16px; margin-bottom: 8px; }
.income-heading { margin-bottom: 12px; }
.income-heading .big-money { margin: 4px 0 24px; }
.big-money { font-size: 40px; line-height: 1.15; font-weight: 750; font-variant-numeric: tabular-nums; }
.big-money .small { font-size: 19px; margin-right: 2px; }

.page .btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
  min-height: 34px;
  padding: 6px 12px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: var(--soft);
  color: var(--green);
  font-size: 13px;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}
.page .btn.primary, .page .btn.white, .modal-actions .btn.primary { min-height: 46px; font-size: 16px; }
.page .btn.primary, .modal-actions .btn.primary { background: var(--green); color: #fff; }
.page .btn.white { background: #fff; }
.page .btn.outline, .modal-actions .btn.outline { background: transparent; border-color: #c4d9cd; color: #315f50; }
.page button.full { width: 100%; }
.page .btn.full { display: flex; }
.page .btn.full + .btn.full { margin-top: 10px; }
.card {
  margin: 12px 0;
  padding: 16px;
  border: 1px solid #e9eeeb;
  border-radius: var(--card-radius);
  background: #fff;
  box-shadow: var(--card-shadow);
}
.card:first-child { margin-top: 0; }
.card.flush { padding-top: 4px; padding-bottom: 4px; }
.divider { height: 1px; background: var(--line); margin: 12px 0; }
.shop { display: flex; align-items: center; gap: 6px; min-width: 0; }
.shop text { overflow-wrap: anywhere; }
.destination { font-size: 24px; font-weight: 750; line-height: 1.3; margin: 10px 0 5px; overflow-wrap: anywhere; }
.destination .em { font-size: 16px; font-weight: 400; }
.items { line-height: 1.6; overflow-wrap: anywhere; }
.order-items { margin-top: 1px; }
.page .order-link { display: block; }
.order-card .divider { margin: 12px 0; }
.amount { color: var(--green); font-size: 18px; font-weight: 750; }
.card-actions { display: flex; gap: 8px; margin-top: 12px; }
.card-actions .btn { flex: 1; min-width: 0; }
.note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin: 12px 0;
  padding: 9px 11px;
  border-radius: 9px;
  background: #ebf1ed;
  color: #536d62;
  font-size: 12px;
  line-height: 1.55;
}
.note .icon { margin-top: 2px; }
.note.warn { background: #fbf3e6; color: var(--amber); }
.note.error { background: #f8eeeb; color: var(--red); }
.error-card .note { margin: 0 0 12px; }

.hero {
  padding: 17px;
  border: 1px solid #1d765a;
  border-radius: 20px;
  color: #fff;
  background: linear-gradient(125deg, #147b58, #225b45);
  box-shadow: 0 10px 26px rgba(20, 123, 88, .19);
}
.hero .label, .hero-sub, .balance-sub .span { color: #d3ebe0; }
.hero .chip { background: rgba(255,255,255,.17); color: #fff; }
.hero .h2 { font-size: 27px; margin: 9px 0 13px; }
.hero-sub { font-size: 16px; font-weight: 400; }
.hero-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  padding-top: 14px;
  border-top: 1px solid rgba(255,255,255,.2);
}
.hero .num { font-size: 30px; font-weight: 750; margin-right: 4px; }
.hero .unit { font-size: 12px; }
.page .hero .outline { color: #fff; border-color: #a2caba; }
.wallet-hero { padding: 16px; }
.wallet-balance { margin-bottom: 12px; }
.wallet-balance .label { display: block; }
.wallet-balance .big-money { margin-top: 3px; font-size: 36px; overflow-wrap: anywhere; }
.wallet-balance .big-money.long-amount { font-size: 28px; }
.wallet-symbol { width: 44px; height: 44px; }
.balance-sub { display: flex; gap: 6px; margin-top: 12px; }
.balance-sub > view { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.balance-sub > view:nth-child(2) { text-align: center; }
.balance-sub > view:last-child { text-align: right; }
.balance-sub .span { display: block; font-size: 11px; }
.balance-sub .b { display: block; font-size: 15px; margin-top: 3px; }
.balance-sub .b.long-amount { font-size: 12px; }
.metrics {
  display: flex;
  overflow: hidden;
  border: 1px solid #e9eeeb;
  border-radius: var(--card-radius);
  background: #fff;
  margin: 12px 0;
}
.sectiontitle + .metrics { margin-top: 0; }
.metric { flex: 1; min-width: 0; padding: 13px 4px; text-align: center; }
.metric + .metric { border-left: 1px solid var(--line); }
.metric .b { display: block; font-size: 20px; overflow-wrap: anywhere; }
.metric .span { display: block; font-size: 11px; color: var(--muted); }

.segmented {
  display: flex;
  gap: 2px;
  padding: 2px;
  width: 100%;
  min-height: 36px;
  border-radius: 10px;
  background: var(--segment);
}
.page .filter,
.modal-layer .sheet-action,
.modal-layer .sheet-option {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.page .filter {
  flex: 1;
  min-width: 0;
  min-height: 32px;
  padding: 3px;
  border-radius: 8px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.25;
}
.filter.active {
  background: #fff;
  color: var(--green);
  font-weight: 700;
  box-shadow: 0 1px 4px rgba(30,55,40,.12);
}
.page .service-card {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
  padding: 13px 14px;
  border: 1px solid #e9eeeb;
  border-radius: 14px;
  background: #fff;
  box-shadow: var(--card-shadow);
}
.service-icon, .rowicon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #eaf2ed;
}
.service-icon { width: 40px; height: 40px; }
.service-card .span { display: block; font-size: 12px; color: var(--muted); }
.page .listrow {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 11px;
  min-height: 58px;
  padding: 8px 0;
}
.listrow + .listrow { border-top: 1px solid var(--line); }
.listrow .text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.listrow .strong, .listrow .small { display: block; }
.listrow .small { font-size: 11px; color: var(--muted); }
.listrow .right { flex: 0 1 auto; text-align: right; }
.listrow .right .b { color: var(--green); overflow-wrap: anywhere; }

.detail-pair {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
  padding: 7px 0;
  font-size: 13px;
}
.detail-pair + .detail-pair { border-top: 1px solid #eef2ef; }
.detail-key { color: var(--muted); flex: 0 0 auto; }
.detail-value { min-width: 0; text-align: right; overflow-wrap: anywhere; }
.group-label { display: block; color: var(--muted); font-size: 11px; font-weight: 650; margin: 0 0 6px; }
.info-group + .info-group { border-top: 1px solid #eef2ef; margin-top: 12px; padding-top: 12px; }
.fees {
  display: flex;
  background: #f2f7f4;
  border-radius: 12px;
  overflow: hidden;
}
.fee {
  flex: 1;
  min-width: 0;
  min-height: 85px;
  padding: 10px 4px;
  text-align: center;
}
.fee + .fee { border-left: 1px solid #e1ebe5; }
.fee-label { display: block; font-size: 11px; color: var(--muted); }
.fee-value { display: block; margin-top: 2px; font-size: 15px; font-weight: 750; overflow-wrap: anywhere; }
.fee:last-child .fee-value { color: var(--green); }
.wallet-fees .fee {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 68px;
}
.product-row { min-height: 37px; padding: 7px 0; font-size: 13px; }
.product-row + .product-row { border-top: 1px solid #eef2ef; }
.product-row .muted { flex: none; }
.delivery-destination .destination { margin: 8px 0 3px; }
.contact-row .muted { display: block; }
.timeline-title { margin: 0 0 9px; }
.timeline-item {
  position: relative;
  margin-left: 5px;
  padding: 0 0 14px 19px;
  border-left: 1px solid #d9e4dd;
  font-size: 13px;
}
.timeline-item:last-child { padding-bottom: 0; }
.timeline-item::before {
  content: '';
  position: absolute;
  width: 8px;
  height: 8px;
  top: 5px;
  left: -4px;
  border-radius: 50%;
  background: #a9c5b4;
}
.timeline-item.current::before { background: var(--green); box-shadow: 0 0 0 3px #e6f2ec; }
.timeline-item .strong, .timeline-item .span { display: block; }
.timeline-item .span { color: var(--muted); font-size: 12px; margin-top: 3px; }
.batch-heading { font-size: 20px; margin-top: 12px; }
.batch-timeline { display: flex; gap: 13px; min-height: 51px; }
.batch-timeline .time { width: 56px; font-weight: 700; }
.batch-timeline .track { position: relative; flex: 1; padding: 0 0 10px 13px; border-left: 1px solid #d8e5dc; }
.batch-timeline .track::before { content: ''; position: absolute; width: 7px; height: 7px; left: -4px; top: 5px; border-radius: 50%; background: #a5c5b2; }
.batch-timeline .track text { display: block; }

.profilehead { display: flex; align-items: center; gap: 12px; margin: 5px 0 18px; }
.profilehead .h2 { font-size: 22px; }
.profilehead .avatar {
  width: 56px; height: 56px;
  border-radius: 18px;
  border: 2px solid #fff;
  background: #deece3;
  box-shadow: 0 4px 12px rgba(20, 123, 88, .15);
  color: var(--green);
  font-size: 23px;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.profile-stats { background: #e6efe8; }
.profile-stats .top-space { margin-top: 6px; }
.profile-symbol { width: 94px; height: 94px; }
.formlabel { display: block; font-size: 12px; color: var(--muted); margin: 12px 0 5px; }
.input, .page button.input {
  width: 100%;
  min-height: 44px;
  padding: 9px 12px;
  border: 1px solid #d8e4dc;
  border-radius: 10px;
  background: #f8faf9;
  font-size: 14px;
  line-height: 24px;
}
.page .picker-field { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.student-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border: 1px dashed #acc9b8;
  border-radius: 12px;
  background: linear-gradient(135deg, #e7f1eb, #f8faf9);
}
.student-card .small { margin-top: 6px; }
.student-photo {
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 44px;
  height: 56px;
  background: #d2e4d7;
  border-radius: 7px;
}
.student-preview { display: block; width: 100%; height: 125px; border-radius: 10px; background: #e6efe8; }
.page .student-card + .link, .page .student-preview + .link { margin-top: 4px; }
.checkline { display: flex; align-items: center; gap: 8px; color: var(--muted); min-height: 28px; font-size: 12px; margin-bottom: 10px; }
.checkline checkbox { flex: none; }
.checkline .wx-checkbox-input { margin: 0; width: 16px; height: 16px; border-color: var(--green); border-radius: 4px; }
.error-text { color: var(--red); font-size: 12px; margin: 6px 0; }
.moneyinput { display: flex; align-items: center; gap: 6px; border-bottom: 1px solid var(--line); padding: 6px 0 5px; margin-bottom: 3px; }
.moneyinput text { font-weight: 750; font-size: 26px; }
.moneyinput input { flex: 1; width: 0; border: 0; background: transparent; min-height: 45px; font-size: 36px; line-height: 45px; }
.amount-placeholder { color: #7c8e84; }

.empty { text-align: center; padding: 50px 0 14px; }
.empty-icon, .successcircle, .audit-illustration {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px;
  width: 64px;
  height: 64px;
  background: #e1efe7;
  border-radius: 20px;
}
.empty-icon .icon { width: 34px; height: 34px; }
.empty .h3 { font-size: 16px; margin-bottom: 6px; }
.empty .top-space { margin-top: 14px; }
.empty .btn { width: 100%; }
.empty-list { text-align: center; padding: 38px 10px; }
.successcircle { border-radius: 50%; margin: 8px auto 12px; }
.successcircle .icon { width: 34px; height: 34px; }
.result-error { background: #fbf0e1; }
.audit-illustration { width: 80px; height: 80px; border-radius: 26px; margin-top: 12px; }

.qrframe {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 16px auto;
  width: 220px;
  max-width: 100%;
  height: 220px;
  border-radius: 19px;
  background: #214939;
  box-shadow: 0 10px 23px rgba(26, 66, 48, .25);
}
.qr-icon { width: 96px; height: 96px; }
.qrframe .corner {
  position: absolute;
  left: 12px;
  top: 12px;
  width: 22px;
  height: 22px;
  border-top: 2px solid #bce0cc;
  border-left: 2px solid #bce0cc;
  border-top-left-radius: 6px;
}
.qrframe .corner:nth-child(2) { left: auto; right: 12px; transform: rotate(90deg); }
.qrframe .corner:nth-child(3) { top: auto; bottom: 12px; transform: rotate(-90deg); }
.qrframe .corner:nth-child(4) { top: auto; bottom: 12px; left: auto; right: 12px; transform: rotate(180deg); }

.map-wrap { position: relative; height: 280px; margin: 0 calc(-1 * var(--gutter)) 12px; background: #d4e3d7; }
.map-native { width: 100%; height: 100%; }
.map-placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
.map-placeholder .icon { width: 84px; height: 84px; }
.map-badge, .map-legend { position: absolute; background: #fff; color: var(--ink); font-size: 11px; padding: 6px 10px; border-radius: 10px; box-shadow: 0 3px 10px rgba(30,55,40,.13); }
.map-badge { top: 12px; left: 16px; font-weight: 700; }
.map-legend { bottom: 12px; right: 16px; color: #526f60; }
.map-pick { width: 100%; white-space: nowrap; }
.page .map-pick button {
  display: inline-flex; align-items: center; min-height: 34px; margin-right: 8px; padding: 4px 12px;
  background: #fff; border: 1px solid #dbe7df; border-radius: 10px; font-size: 12px;
}
.page .map-pick button.active { background: #eaf3ed; border-color: var(--green); color: var(--green); font-weight: 700; }

.modal-layer {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(24, 53, 44, .44);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.modal {
  width: 100%;
  max-width: 390px;
  max-height: 80vh;
  overflow: auto;
  padding: 20px;
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 12px 35px rgba(24, 53, 44, .2);
}
.modal-copy { margin-top: 9px; font-size: 13px; line-height: 1.7; color: var(--muted); }
.modal-actions { display: flex; gap: 8px; margin-top: 16px; }
.modal-actions .btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 6px 12px;
  border: 1px solid transparent;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 700;
  text-align: center;
}
.modal-actions .btn.outline { border-color: #c4d9cd; }
.sheet-layer { align-items: flex-end; padding: 0; }
.picker-sheet {
  width: 100%;
  max-width: 560px;
  max-height: 85vh;
  overflow: auto;
  padding: 0 16px calc(12px + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 18px 18px 0 0;
}
.sheet-heading { min-height: 52px; font-weight: 750; }
.modal-layer .sheet-action { color: var(--green); min-height: 44px; min-width: 48px; }
.sheet-action.muted { color: var(--muted); }
.modal-layer .sheet-option { min-height: 44px; width: 100%; font-size: 16px; }
.sheet-option.selected { color: var(--green); font-weight: 750; }

.withdraw-amount { margin: 4px 0 9px; }
.settlement-times { border-top: 1px solid #eef2ef; margin-top: 12px; padding-top: 12px; }
