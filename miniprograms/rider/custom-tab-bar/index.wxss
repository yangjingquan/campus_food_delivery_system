.tabbar {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 64px;
  margin: 0 auto;
  padding: 4px 2px;
  box-sizing: border-box;
  background: #fff;
  border: 1px solid #e6ede7;
  border-radius: 999px;
  box-shadow: 0 4px 13px rgba(30, 55, 40, .11);
}

.tabbar button.tab {
  flex: 1 1 0;
  width: 0;
  max-width: none;
  min-width: 0;
  min-height: 52px;
  margin: 0;
  padding: 0 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4px;
  border: 0;
  background: transparent;
  color: #698575;
  font-size: 11px;
  line-height: 1.2;
  white-space: nowrap;
}
.tab::after { border: 0; }
.tab.active { color: #147b58; font-weight: 700; }
.tabicon, .tabicon image { display: block; width: 22px; height: 22px; }
.pressed { opacity: .75; }
