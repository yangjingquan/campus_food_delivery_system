<import src="../../fragments/states.wxml" />
<view class="screen product-editor dock-screen">
  <template is="state" data="{{error, loading}}" />
  <block wx:if="{{!error && !loading}}">
    <view class="editor-sheet">
      <view class="editor-section">
        <view class="section">基本信息</view>
        <view class="editor-field">
          <text class="label">商品名称</text>
          <input aria-label="商品名称" class="field" data-field="name" bindinput="input" value="{{form.name}}" placeholder="请输入商品名称" maxlength="120" />
        </view>
        <view class="editor-field">
          <text class="label">分类</text>
          <picker aria-label="食品分类" mode="selector" range="{{categories}}" value="{{categoryIndex}}"
            disabled="{{!categories.length || saving}}" bindchange="selectCategory">
            <view class="field row editor-picker">
              <text class="flex">{{form.category || (categories.length ? '请选择食品分类' : '暂无可选食品分类')}}</text>
              <view class="editor-chevron" aria-hidden="true" />
            </view>
          </picker>
        </view>
        <view class="editor-field">
          <text class="label">商品描述</text>
          <textarea aria-label="商品描述" class="field" data-field="description" bindinput="input"
            value="{{form.description}}" placeholder="选填，最多 500 字" maxlength="500" />
        </view>
      </view>

      <view class="editor-section">
        <view class="section">价格与库存</view>
        <view class="field-grid editor-field">
          <view>
            <text class="label">售价（元）</text>
            <view class="currency-field">
              <text aria-hidden="true">¥</text>
              <input aria-label="售价（元）" class="field" type="digit" data-field="price" bindinput="input" value="{{form.price}}" />
            </view>
          </view>
          <view>
            <text class="label">总库存（份）</text>
            <input aria-label="总库存（份）" class="field" type="number" data-field="stock" bindinput="input" value="{{form.stock}}" />
          </view>
        </view>
        <view class="hint editor-stock-note">库存为 0 时显示售罄。待支付订单已预占 {{form.reserved || 0}} 份。</view>
        <view class="editor-status">
          <text class="editor-status-label">销售状态</text>
          <view class="editor-status-options" aria-label="销售状态">
            <button class="editor-status-choice {{form.available ? 'selected' : ''}}" data-status="on"
              aria-pressed="{{form.available}}" disabled="{{saving}}" bindtap="availability" hover-class="pressed">上架</button>
            <button class="editor-status-choice {{!form.available ? 'selected' : ''}}" data-status="off"
              aria-pressed="{{!form.available}}" disabled="{{saving}}" bindtap="availability" hover-class="pressed">下架</button>
          </view>
        </view>
        <view wx:if="{{formError}}" class="notice error" aria-live="polite">{{formError}}</view>
      </view>

      <view class="editor-section">
        <view class="row">
          <view class="section">商品图片</view>
          <text wx:if="{{!id}}" class="hint">必填</text>
        </view>
        <button class="editor-photo-button" bindtap="choosePhoto" disabled="{{saving || choosingPhoto}}" hover-class="pressed"
          aria-label="{{photo || form.hasPhoto ? '更换商品图片' : '添加商品图片'}}">
          <view class="editor-photo-preview">
            <image wx:if="{{photo}}" class="editor-photo-image" src="{{photo}}" mode="aspectFit" aria-label="商品图片预览" />
            <image wx:else class="icon" src="/assets/ui/photo.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <view class="editor-photo-copy flex">
            <view class="editor-photo-action">{{choosingPhoto ? '正在选择图片…' : photo || form.hasPhoto ? '更换图片' : '添加图片'}}</view>
            <view class="hint">JPEG 或 PNG，最多 1 张，最大 1 MB</view>
          </view>
          <view class="editor-chevron" aria-hidden="true" />
        </button>
        <view wx:if="{{photoError}}" class="notice error" aria-live="polite">{{photoError}}</view>
      </view>

      <view wx:if="{{id}}" class="editor-section">
        <view class="section">手动库存调整记录</view>
        <view wx:if="{{!history.length}}" class="hint editor-history-row">暂无手动调整</view>
        <view wx:for="{{history}}" wx:key="index" class="kv editor-history-row">
          <text>{{item.time}}</text><text>{{item.previousStock}} → {{item.newStock}} 份</text>
        </view>
      </view>
    </view>
    <view class="action-dock">
      <button class="btn primary" bindtap="save" loading="{{saving}}" disabled="{{saving || choosingPhoto}}" hover-class="pressed">保存商品</button>
    </view>
  </block>
</view>
