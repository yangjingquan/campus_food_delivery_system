<import src="../../fragments/states.wxml" />
<view class="screen finance-screen tab-screen">
  <view class="heading">经营与账户</view>
  <view class="hint">查看本店实收、退款与账户资金</view>
  <template is="state" data="{{blocked, error, loading}}" />
  <block wx:if="{{!blocked && !error && !loading && account}}">
    <view class="hero">
      <view class="row top">
        <view><view class="muted">可提现余额</view><view class="number">{{account.available}}</view></view>
        <button class="btn" bindtap="withdraw" hover-class="pressed">申请提现</button>
      </view>
      <view class="row muted wrap hero-foot"><text>冻结 {{account.frozen}}</text><text>待扣回 {{account.debt}}</text></view>
    </view>
    <view class="card">
      <view class="section">销售概况</view>
      <view class="filters">
        <button wx:for="{{periods}}" wx:key="days" class="filter {{item.days === days ? 'active' : ''}}" data-days="{{item.days}}" bindtap="period" hover-class="pressed">{{item.label}}</button>
      </view>
      <view class="sales-grid">
        <view class="kv"><text>支付订单</text><text>{{sales.count}} 单</text></view>
        <view class="kv"><text>实付金额</text><text>{{sales.paid}}</text></view>
        <view class="kv"><text>餐品金额</text><text>{{sales.food}}</text></view>
        <view class="kv"><text>已退金额</text><text>{{sales.refunded}}</text></view>
        <view class="kv net"><text>扣除退款后实收</text><text class="price">{{sales.net}}</text></view>
      </view>
      <view class="hint">按北京时间支付日期归集。实收含配送费，商户收入以结算与流水为准。</view>
    </view>
    <view class="tile-grid finance-tiles">
      <button class="nav-tile settlements" data-kind="settlements" bindtap="records" hover-class="pressed">
        <view class="tile-heading"><image class="icon" src="/assets/ui/receipt.svg" mode="aspectFit" aria-hidden="true" /><text>订单结算</text></view>
        <text class="tile-link">查看 ›</text>
      </button>
      <button class="nav-tile debts" data-kind="debts" bindtap="records" hover-class="pressed">
        <view class="tile-heading"><image class="icon" src="/assets/ui/wallet.svg" mode="aspectFit" aria-hidden="true" /><text>欠款与扣回</text></view>
        <text class="tile-link">查看 ›</text>
      </button>
      <button class="nav-tile ledger" data-kind="ledger" bindtap="records" hover-class="pressed">
        <view class="tile-heading"><image class="icon" src="/assets/ui/ledger.svg" mode="aspectFit" aria-hidden="true" /><text>资金流水</text></view>
        <text class="tile-link">查看 ›</text>
      </button>
      <button class="nav-tile withdrawals" data-kind="withdrawals" bindtap="records" hover-class="pressed">
        <view class="tile-heading"><image class="icon" src="/assets/ui/cash.svg" mode="aspectFit" aria-hidden="true" /><text>提现记录</text></view>
        <text class="tile-link">查看 ›</text>
      </button>
    </view>
  </block>
</view>
