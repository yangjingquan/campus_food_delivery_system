<import src="../../fragments/states.wxml" />
<view class="screen orders-screen tab-screen">
  <view class="row top page-header">
    <view class="flex">
      <view class="heading">{{store.name || '订单工作台'}}</view>
      <view class="hint">查看本店订单，接单并确认到点</view>
    </view>
    <text wx:if="{{store && !blocked}}" class="badge {{store.businessStatus === '营业中' ? '' : 'neutral'}}">{{store.businessStatus === '营业中' ? '营业中' : '已打烊'}}</text>
  </view>
  <template is="state" data="{{blocked, error, loading: loading && !rows.length}}" />
  <block wx:if="{{!blocked && !error && (!loading || rows.length)}}">
    <view class="hero row">
      <view>
        <view class="muted">待接单</view>
        <view class="number">{{counts.waiting || 0}} <text class="muted">单</text></view>
      </view>
      <button class="btn" bindtap="aftersales" hover-class="pressed">售后待办 {{counts.aftersales || 0}}</button>
    </view>
    <view class="row search-bar">
      <input class="search flex" aria-label="取餐号、订单号或商品名称" placeholder="取餐号、订单号或商品名称" value="{{q}}" bindinput="search" bindconfirm="submitSearch" confirm-type="search" maxlength="64" />
      <button class="btn plain" bindtap="submitSearch" hover-class="pressed">搜索</button>
    </view>
    <view class="filters">
      <button wx:for="{{filters}}" wx:key="label" class="filter {{index === filter ? 'active' : ''}}" data-index="{{index}}" bindtap="filter" hover-class="pressed">{{item.label}}</button>
    </view>
    <view wx:if="{{formError}}" class="notice error">{{formError}}</view>
    <view wx:if="{{!rows.length}}" class="card empty muted">没有符合条件的订单</view>
    <view wx:for="{{rows}}" wx:key="id" class="card work-card" data-id="{{item.id}}" bindtap="details" hover-class="pressed">
      <view class="row summary">
        <view class="flex">
          <text class="section mono">{{item.pickupCode || item.suffix}}</text>
          <text class="badge">{{item.fulfillmentType === 'pickup' ? '自取' : '外卖'}}</text>
        </view>
        <text class="badge {{item.status === '待商户接单' ? 'warn' : item.status === '已关闭' ? 'neutral' : ''}}">{{item.status}}</text>
      </view>
      <view class="row top"><text class="flex">{{item.items}}</text><text class="price">{{item.amount}}</text></view>
      <view class="hint">{{item.time}}</view>
      <view wx:if="{{item.status === '待商户接单'}}" class="hint deadline">{{item.acceptExpired ? '已过接单时限' : '接单截止 ' + item.deadline}}</view>
      <view wx:if="{{item.intervene}}" class="notice">{{item.interveneReason || '待管理员介入'}}</view>
      <view class="actions {{item.status === '待商户接单' ? 'accept-actions' : ''}}">
        <button wx:if="{{!item.pendingRefund && item.status === '商户出餐中'}}" class="btn primary" data-id="{{item.id}}" data-action="{{item.fulfillmentType === 'pickup' ? 'ready' : 'arrive'}}" catchtap="update" disabled="{{saving}}" hover-class="pressed" hover-stop-propagation>{{item.fulfillmentType === 'pickup' ? '餐品已备好' : '确认到点'}}</button>
        <button wx:if="{{!item.pendingRefund && item.status === '待自取'}}" class="btn primary" data-id="{{item.id}}" data-action="collect" catchtap="update" disabled="{{saving}}" hover-class="pressed" hover-stop-propagation>确认已取餐</button>
        <button class="btn plain order-details" data-id="{{item.id}}" catchtap="details" hover-class="pressed" hover-stop-propagation>订单详情</button>
        <button wx:if="{{!item.pendingRefund && !item.intervene && !item.acceptExpired && item.status === '待商户接单'}}" class="btn primary" data-id="{{item.id}}" data-action="accept" catchtap="update" disabled="{{saving}}" hover-class="pressed" hover-stop-propagation>确认接单</button>
      </view>
    </view>
    <view wx:if="{{loading && hasMore}}" class="hint empty" aria-live="polite">正在加载更多订单…</view>
    <view wx:elif="{{moreError}}" class="hint empty">
      <view>{{moreError}}</view>
      <button class="btn plain centered separator" bindtap="loadMore" hover-class="pressed">重试加载更多</button>
    </view>
    <view wx:elif="{{rows.length && !hasMore && !loading}}" class="hint empty">没有更多订单了</view>
  </block>
</view>
