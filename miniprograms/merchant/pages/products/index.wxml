<wxs module="states" src="../../utils/states.wxs"/>
<import src="../../fragments/states.wxml" />
<view class="products-screen">
  <scroll-view class="products-scroll" scroll-y="{{!dragLocked}}" scroll-top="{{scrollTop}}" bindscroll="onScroll"
    refresher-enabled="{{!orderSaving && !dragLocked}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="pullRefresh">
    <view class="screen products-content">
      <view class="row top page-header">
        <view class="flex"><view class="heading">商品管理</view><view class="hint">管理售价、库存与上下架</view></view>
        <button wx:if="{{!blocked && !loading && !error}}" class="btn primary" bindtap="edit"
          disabled="{{orderSaving || dragFrom >= 0}}" hover-class="pressed">新增商品</button>
      </view>
      <template is="state" data="{{blocked, error, loading}}" />
      <block wx:if="{{!blocked && !error && !loading}}">
        <view class="filters">
          <button wx:for="{{labels}}" wx:key="*this" class="filter {{index === filter ? 'active' : ''}}" data-index="{{index}}"
            bindtap="select" hover-class="pressed" disabled="{{orderSaving || dragFrom >= 0}}">{{item}}</button>
        </view>
        <view wx:if="{{formError}}" class="notice error">{{formError}}</view>
        <view wx:if="{{!visible.length}}" class="card empty muted">当前分类暂无商品</view>
        <view>
          <view wx:for="{{visible}}" wx:key="id"
            class="product-sort-row {{index === dragFrom ? 'is-dragging' : ''}} {{index === dragTo && index < dragFrom ? 'drop-before' : ''}} {{index === dragTo && index > dragFrom ? 'drop-after' : ''}}"
            style="{{index === dragFrom ? 'transform:translateY(' + dragOffset + 'px);' : ''}}">
            <view class="card work-card">
              <view class="row top product-line">
                <view class="product-thumb {{item.hasPhoto ? 'load-thumbnail' : ''}}" data-id="{{item.id}}">
                  <image wx:if="{{thumbnails[item.id]}}" class="product-thumb-image" src="{{thumbnails[item.id]}}"
                    mode="aspectFill" lazy-load aria-label="商品图片" />
                  <image wx:else class="icon" src="/assets/ui/photo.svg" mode="aspectFit" aria-hidden="true" />
                </view>
                <view class="flex">
                  <view class="section">{{item.name}}</view>
                  <view class="hint">{{item.category}} · 可售 {{item.availableStock}} 份 · 预占 {{item.reserved}} 份</view>
                  <view class="price">{{item.price}}</view>
                </view>
                <text class="badge {{item.status !== 'PRODUCT_AVAILABLE' ? 'warn' : ''}}">{{states.label(item.status)}}</text>
              </view>
              <view class="actions split-actions product-actions">
                <button class="btn plain" data-id="{{item.id}}" bindtap="edit"
                  disabled="{{orderSaving || dragFrom >= 0}}" hover-class="pressed">编辑／库存记录</button>
                <view class="product-actions-end">
                  <button wx:if="{{visible.length > 1}}" class="product-handle" aria-label="{{'移动' + item.name}}"
                    data-index="{{index}}" disabled="{{saving || orderSaving || orderConflict}}"
                    bindtap="moveOptions" catchtouchstart="startDrag" catchtouchmove="moveDrag"
                    catchtouchend="endDrag" catchtouchcancel="cancelDrag" hover-class="product-handle-pressed">
                    <view class="product-grip" aria-hidden="true"><view /><view /><view /><view /><view /><view /></view>
                  </button>
                  <button class="btn {{item.available ? 'plain' : 'primary'}}" data-id="{{item.id}}" bindtap="toggle"
                    disabled="{{saving || orderSaving || dragFrom >= 0}}" hover-class="pressed">{{item.available ? '下架' : '上架'}}</button>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
  <view wx:if="{{orderChanged && !blocked && !error}}" class="products-order-footer">
    <view wx:if="{{orderError}}" class="notice error" aria-live="polite">{{orderError}}</view>
    <button wx:if="{{orderConflict}}" class="btn primary wide" bindtap="reloadOrder" hover-class="pressed">重新加载</button>
    <view wx:else class="products-order-actions">
      <button class="btn plain" bindtap="cancelOrder" disabled="{{orderSaving || dragFrom >= 0}}" hover-class="pressed">取消</button>
      <button class="btn primary" bindtap="saveOrder" loading="{{orderSaving}}"
        disabled="{{orderSaving || saving || dragFrom >= 0}}" hover-class="pressed">保存顺序</button>
    </view>
  </view>
</view>
