<import src="../../fragments/states.wxml" />
<view class="screen mine-screen tab-screen">
  <view class="heading">我的店铺</view>
  <view class="hint">营业状态、审核资料和接单设备</view>
  <template is="state" data="{{error, loading, blocked}}" />
  <block wx:if="{{loggedIn && !error && !loading}}">
    <view class="hero">
      <view class="row"><text class="section flex">{{store.name || '提交商户入驻'}}</text><text class="badge">{{store.auditStatus || '未申请'}}</text></view>
      <view class="muted separator">{{store.address || '完成资料提交后可查看审核进度'}}</view>
    </view>
    <view class="tile-grid">
      <button class="nav-tile" bindtap="shop" hover-class="pressed">
        <view class="tile-heading"><image class="icon" src="/assets/ui/store.svg" mode="aspectFit" aria-hidden="true" /><text>{{store.auditStatus === '已通过' ? '店铺资料与变更' : '入驻资料与进度'}}</text></view>
        <text class="tile-link">{{revision.status || '查看 ›'}}</text>
      </button>
      <button wx:if="{{store.auditStatus === '已通过'}}" class="nav-tile" bindtap="devices" hover-class="pressed">
        <view class="tile-heading"><image class="icon" src="/assets/ui/printer.svg" mode="aspectFit" aria-hidden="true" /><text>打印设备与订阅消息</text></view><text class="tile-link">查看 ›</text>
      </button>
    </view>
    <view wx:if="{{store.auditStatus === '已通过'}}" class="card row business-card">
      <view class="flex"><view class="business-status"><text class="status-dot {{store.businessStatus === '营业中' ? '' : 'closed'}}"></text><text class="section">{{store.businessStatus}}</text></view><view class="hint">店铺营业状态</view></view>
      <button class="btn plain" bindtap="business" disabled="{{saving}}" hover-class="pressed">{{store.businessStatus === '营业中' ? '打烊' : '开始营业'}}</button>
    </view>
    <view wx:if="{{store.auditStatus === '已通过'}}" class="card">
      <text class="label">起送价（元）</text>
      <view class="row form-row">
        <view class="currency-field flex"><text aria-hidden="true">¥</text><input class="field" type="digit" value="{{minimumOrder}}" bindinput="inputMinimumOrder"
        aria-label="起送价（元）" maxlength="12" disabled="{{saving}}" /></view>
        <button class="btn primary" bindtap="saveMinimumOrder" disabled="{{saving}}" hover-class="pressed">保存起送价</button>
      </view>
      <view class="hint">按本店商品金额计算，不含配送费。设为 0 表示不限。</view>
      <view wx:if="{{minimumOrderError}}" class="notice error">{{minimumOrderError}}</view>
    </view>
    <view wx:if="{{formError}}" class="notice error">{{formError}}</view>
    <button class="btn plain centered logout-button" bindtap="logout" disabled="{{saving}}" hover-class="pressed">退出登录</button>
  </block>
</view>
