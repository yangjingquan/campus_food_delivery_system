<import src="../../fragments/states.wxml" />
<view class="screen">
  <view class="heading">{{title}}</view>
  <view class="hint">显示最近 100 条本店记录</view>
  <template is="state" data="{{error, loading}}" />
  <view wx:if="{{!error && !loading && !rows.length}}" class="card empty muted">暂无记录</view>
  <block wx:if="{{!error && !loading}}">
    <view wx:for="{{rows}}" wx:key="id" class="card">
      <block wx:if="{{kind === 'withdrawals'}}">
        <view class="row summary"><text class="price">{{item.amount}}</text><text class="badge">{{item.status}}</text></view>
        <view class="hint">{{item.time}}</view>
        <view class="kv"><text>申请编号</text><text class="mono" selectable>{{item.id}}</text></view>
        <view wx:if="{{item.reason}}" class="notice">{{item.reason}}</view>
      </block>
      <block wx:elif="{{kind === 'settlements'}}">
        <view class="row summary"><text class="section">订单结算</text><text class="badge">{{item.status}}</text></view>
        <view class="kv"><text>餐品实付</text><text>{{item.food}}</text></view>
        <view class="kv"><text>餐品已退款</text><text>{{item.refunded}}</text></view>
        <view class="kv"><text>配送完成</text><text>{{item.time}}</text></view>
        <view wx:if="{{item.foodRate != null}}" class="kv"><text>餐品抽成</text><text>{{item.foodRate}}%</text></view>
        <view wx:if="{{item.net}}" class="kv"><text>商户入账</text><text>{{item.net}} · {{item.netTime}}</text></view>
        <button class="btn plain wide separator" data-id="{{item.id}}" bindtap="order" hover-class="pressed">查看订单</button>
      </block>
      <block wx:elif="{{kind === 'debts'}}">
        <view class="row summary"><text class="section">待扣回</text><text class="price">{{item.debt}}</text></view>
        <view class="kv"><text>骑手应得</text><text>{{item.riderAmount}}</text></view>
        <view class="kv"><text>平台垫付</text><text>{{item.advance}}</text></view>
        <view class="kv"><text>已扣回</text><text>{{item.recovered}}</text></view>
        <view wx:if="{{item.note}}" class="hint">{{item.note}}</view>
        <button class="btn plain wide separator" data-id="{{item.orderId}}" bindtap="order" hover-class="pressed">查看关联订单</button>
      </block>
      <block wx:else>
        <view class="row summary"><text class="section">{{item.label}}</text><text class="muted">{{item.time}}</text></view>
        <view class="kv"><text>可用变动</text><text>{{item.available}}</text></view>
        <view class="kv"><text>冻结变动</text><text>{{item.frozen}}</text></view>
        <view class="kv"><text>关联单号</text><text class="mono" selectable>{{item.referenceId}}</text></view>
      </block>
    </view>
  </block>
</view>
