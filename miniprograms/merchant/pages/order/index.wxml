<import src="../../fragments/states.wxml" />
<view class="screen">
  <view class="heading">订单详情</view>
  <template is="state" data="{{error, loading: loading && !order}}" />
  <block wx:if="{{order && !error}}">
    <view class="hint mono" selectable>{{order.id}}</view>
    <view class="card">
      <view class="row summary"><text class="section">履约进度</text><text class="badge">{{order.status}}</text></view>
      <view class="kv"><text>支付</text><text>{{order.paymentStatus}}</text></view>
      <view class="kv"><text>售后</text><text>{{order.refundStatus}}</text></view>
      <view class="kv"><text>结算</text><text>{{order.settlementStatus}}</text></view>
      <view class="kv"><text>支付时间</text><text>{{paidAt}}</text></view>
      <view wx:if="{{order.status === '待商户接单'}}" class="kv"><text>接单截止</text><text>{{deadline}}{{acceptExpired ? ' · 已超时' : ''}}</text></view>
      <view wx:if="{{arrivedAt}}" class="kv"><text>送达暂存点</text><text>{{arrivedAt}}</text></view>
      <view wx:if="{{order.intervene}}" class="notice">{{order.interveneReason || '待管理员介入'}}</view>
      <view class="actions">
        <button wx:if="{{!order.pendingRefund && !order.intervene && !acceptExpired && order.status === '待商户接单'}}" class="btn primary" data-action="accept" bindtap="status" disabled="{{saving}}" hover-class="pressed">确认接单</button>
        <button wx:if="{{!order.pendingRefund && order.status === '商户出餐中'}}" class="btn primary" data-action="arrive" bindtap="status" disabled="{{saving}}" hover-class="pressed">确认到点</button>
        <button wx:if="{{order.accepted && order.status !== '已关闭'}}" class="btn" bindtap="ticket" hover-class="pressed">小票／补打</button>
        <button wx:if="{{order.status === '配送中'}}" class="btn" bindtap="map" hover-class="pressed">骑手位置</button>
      </view>
    </view>
    <view class="card">
      <view class="section">餐品与费用</view>
      <view wx:for="{{lines}}" wx:key="index" class="kv"><text>{{item.name}} × {{item.quantity}}</text><text>{{item.amount}}</text></view>
      <view class="kv"><text>餐品小计</text><text>{{amounts.food}}</text></view>
      <view class="kv"><text>配送费</text><text>{{amounts.delivery}}</text></view>
      <view class="kv"><text>实付</text><text class="price">{{amounts.paid}}</text></view>
      <view class="kv"><text>已退款</text><text>{{amounts.refunded}}</text></view>
      <view class="kv"><text>支付单号</text><text class="mono" selectable>{{order.paymentId}}</text></view>
    </view>
    <view class="card">
      <view class="section">收餐信息</view>
      <view class="kv"><text>{{order.delivery.receiverName}}</text><text>{{order.delivery.building}} {{order.delivery.room}}</text></view>
      <button class="btn plain wide separator" bindtap="phone" hover-class="pressed">联系用户 {{order.delivery.phone}}</button>
    </view>
    <view class="card">
      <view class="section">售后处理</view>
      <view wx:if="{{!aftersales.length}}" class="hint">暂无售后申请</view>
      <view wx:for="{{aftersales}}" wx:key="id" class="separator">
        <view class="row summary"><text class="price">{{item.amount}}</text><text class="badge">{{item.status}}</text></view>
        <view>{{item.reason}}</view><view class="hint">{{item.time}} · {{item.channelStatus}}</view>
        <view wx:if="{{item.channelReason}}" class="notice">{{item.channelReason}}</view>
        <view wx:if="{{item.offlineTime}}" class="hint">线下实退 {{item.offlineTime}} · {{item.offlineChannel}}</view>
        <view wx:if="{{item.status === '待商户处理'}}" class="actions">
          <button class="btn primary" data-action="approve" data-id="{{item.id}}" bindtap="startRefund" disabled="{{saving}}" hover-class="pressed">同意退款</button>
          <button class="btn plain" data-action="reject" data-id="{{item.id}}" bindtap="startRefund" disabled="{{saving}}" hover-class="pressed">拒绝退款</button>
        </view>
        <button wx:if="{{item.status === '拒绝退款'}}" class="btn plain wide separator" data-action="end" data-id="{{item.id}}" bindtap="startRefund" disabled="{{saving}}" hover-class="pressed">协商不退款，结束售后</button>
      </view>
      <button wx:if="{{order.accepted && !order.pendingRefund && remaining > 0 && order.refundStatus !== '退款失败'}}" class="btn wide separator" data-action="negotiate" bindtap="startRefund" disabled="{{saving}}" hover-class="pressed">发起协商退款</button>
    </view>
    <view wx:if="{{refundForm}}" class="card" id="refund-form">
      <view class="section">{{refundForm.action === 'reject' ? '填写拒绝原因' : refundForm.action === 'end' ? '结束售后' : '确认退款金额'}}</view>
      <block wx:if="{{refundForm.action === 'negotiate' || refundForm.action === 'approve'}}">
        <view class="hint">剩余实付 {{amounts.remaining}} · 餐品可退 {{amounts.foodRemaining}}</view>
        <text class="label">退款类型</text>
        <picker range="{{['退剩余实付', '部分退餐品']}}" value="{{refundForm.type === 'partial' ? 1 : 0}}" bindchange="type">
          <view class="field">{{refundForm.type === 'partial' ? '部分退餐品' : '退剩余实付'}}</view>
        </picker>
        <block wx:if="{{refundForm.type === 'partial'}}">
          <text class="label">部分退款金额（元）</text>
          <input aria-label="部分退款金额（元）" class="field" type="digit" data-field="amount" bindinput="input" value="{{refundForm.amount}}" />
        </block>
        <view class="row separator"><text>退款成功后恢复该单库存</text><switch aria-label="退款成功后恢复该单库存" checked="{{refundForm.restoreStock}}" color="#167953" bindchange="restore" /></view>
      </block>
      <block wx:if="{{refundForm.action === 'reject' || refundForm.action === 'negotiate'}}">
        <text class="label">处理原因</text><textarea aria-label="处理原因" class="field" data-field="reason" bindinput="input" value="{{refundForm.reason}}" maxlength="500" />
      </block>
      <view wx:if="{{formError}}" class="notice error">{{formError}}</view>
      <view class="actions"><button class="btn plain" bindtap="cancelRefund" disabled="{{saving}}" hover-class="pressed">取消</button><button class="btn primary" bindtap="submitRefund" disabled="{{saving}}" loading="{{saving}}" hover-class="pressed">确认处理</button></view>
    </view>
    <view wx:elif="{{formError}}" class="notice error">{{formError}}</view>
    <view wx:if="{{events.length}}" class="card">
      <view class="section">履约记录</view>
      <view wx:for="{{events}}" wx:key="index" class="kv"><text>{{item.note}}</text><text class="muted">{{item.time}}</text></view>
    </view>
  </block>
</view>
