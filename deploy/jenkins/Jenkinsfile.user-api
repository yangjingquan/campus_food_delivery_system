pipeline {
    agent any
    options { disableConcurrentBuilds(); timeout(time: 45, unit: 'MINUTES') }
    environment {
        CFD_SERVICE = 'user-api'
        CFD_IMAGE = 'campus-food/user-api'
        CFD_DOCKERFILE = 'user-api/Dockerfile'
    }
    stages {
        stage('Checkout') { steps { checkout scm; sh 'git rev-parse --short=12 HEAD' } }
        stage('Build image') {
            steps {
                script { env.CFD_IMAGE_TAG = "${env.BUILD_NUMBER}-${sh(returnStdout: true, script: 'git rev-parse --short=12 HEAD').trim()}" }
                sh 'flock -x /var/jenkins_home/.campus-food-build.lock docker build --label campus-food.service=$CFD_SERVICE -t $CFD_IMAGE:$CFD_IMAGE_TAG -f $CFD_DOCKERFILE .'
            }
        }
        stage('Deploy this service') {
            steps {
                sh '''
                    set -eu
                    host_workspace=$(printf '%s' "$WORKSPACE" | sed 's#^/var/jenkins_home#/opt/jenkins/jenkins_home#')
                    test -f "$host_workspace/deploy/production/deploy-service.sh"
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      -v /usr/bin/docker:/usr/bin/docker:ro \
                      -v /usr/libexec/docker/cli-plugins:/usr/libexec/docker/cli-plugins:ro \
                      -v "$host_workspace:/src:ro" \
                      -v /opt/campus-food:/prod \
                      -e SERVICE_NAME="$CFD_SERVICE" \
                      -e SERVICE_TAG="$CFD_IMAGE_TAG" \
                      alpine:3.20 sh /src/deploy/production/deploy-service.sh
                '''
            }
        }
    }
    post {
        success { echo "user-api deployed as ${env.CFD_IMAGE}:${env.CFD_IMAGE_TAG}" }
        failure { echo 'Deployment failed. Review the stage log; a failed health check attempts to restore the last recorded image tag.' }
    }
}
