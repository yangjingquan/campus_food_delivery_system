<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusfood.admin.dao.WithdrawalDao">
    <!-- 依赖幂等键唯一约束，重复申请不再插入新的意图记录。 -->
    <insert id="insertIntentIfAbsent">
        INSERT IGNORE INTO withdrawal_intent(request_key,account_id,requested_cents,status) VALUES(#{requestKey},
        #{accountId},#{requestedCents},#{status})
    </insert>

    <insert id="insertWithdrawal">
        INSERT INTO withdrawal_request(id,applicant,applicant_type,amount_cents,status,created_at,
        account_id,request_key) VALUES(#{id},#{applicant},#{applicantType},#{amount},#{status},
        #{createdAt},#{accountId},#{requestKey})
    </insert>

    <insert id="insertReviewAudit">
        INSERT INTO admin_audit_log(actor,action_name,target_id,before_status,after_status,reason) VALUES (#{actor},
        #{action},#{targetId},#{beforeState},#{afterState},#{reason})
    </insert>

    <select id="hasReviewHistory" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM admin_audit_log
        WHERE action_name='withdrawal.review' AND target_id=#{id})
    </select>

    <select id="hasRetryRecipient" resultType="boolean">
        SELECT EXISTS (
        <choose>
            <when test="type == 'MERCHANT'">
                SELECT 1 FROM merchant_transfer_channel c
                JOIN merchant_identity i ON i.merchant_id=#{accountId}
                    AND i.app_id=c.app_id AND i.open_id=c.recipient_open_id
                JOIN wechat_config cfg ON cfg.id=(SELECT MAX(id) FROM wechat_config)
                    AND cfg.merchant_app_id=c.app_id AND cfg.merchant_no=c.merchant_no
            </when>
            <otherwise>
                SELECT 1 FROM rider_transfer_channel c
                JOIN rider_identity i ON i.id=#{accountId} AND i.app_id=c.app_id
                    AND i.openid=COALESCE(c.recipient_open_id,i.openid) AND i.openid&lt;&gt;''
                JOIN wechat_config cfg ON cfg.id=(SELECT MAX(id) FROM wechat_config)
                    AND cfg.rider_app_id=c.app_id AND cfg.merchant_no=c.merchant_no
            </otherwise>
        </choose>
        WHERE c.withdrawal_id=#{id} AND c.channel_state IN ('FAIL','CANCELLED'))
    </select>

    <insert id="insertTransfer">
        INSERT INTO withdrawal_transfer(id,withdrawal_id,status) VALUES(#{transferId},#{withdrawalId},#{status})
    </insert>

    <insert id="insertChannelAudit">
        INSERT INTO admin_audit_log(actor,action_name,target_id,before_status,after_status,reason) VALUES('渠道服务',
        'withdrawal.channel',#{withdrawalId},'TRANSFERRING',#{afterState},#{reason})
    </insert>

    <insert id="insertJournal">
        INSERT INTO account_journal(account_id,event_type,reference_id,available_delta,frozen_delta,
        request_key,debt_id) VALUES(#{accountId},#{eventType},#{referenceId},#{availableDelta},
        #{frozenDelta},#{requestKey},#{debtId})
    </insert>
</mapper>
